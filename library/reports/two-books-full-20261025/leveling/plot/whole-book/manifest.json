  "threads": [
    {
      "id": "book-double-spy",
      "number": 1,
      "status": "resolved",
      "anchor": "event-980811f14be9bed1d94f",
      "conclusion": "盐磷与黑蛇定位匡飞、天骑后，天狂逐前者而留后者，利用狂龙以为尚有未曝光内线的误判传递假情报。天骑后来承认钱与暗恋林菲的动机，完成围狂龙后被逐。后段收买圣剑是另一场公开信息受限的博弈，只作机制回响，不能把圣剑并为同一内线。"
    },
    {
      "id": "book-taburet-oslinlan",
      "number": 2,
      "status": "resolved",
      "anchor": "event-cc179c6da26a3a5403bf",
      "conclusion": "阳光折射才显出的吊坠铭文重释塔布雷特的忍痛凝望；提莫斯偷项链诱其赴修道院，夺本命骷髅又触发奥斯林兰预设的同死诅咒。修道院阶段已有释放与宽恕，最终神之境直接看见塔布雷特、奥斯林兰幸福相拥，是后文确证的迟到收束。不能继续把这对人物标为全书未解。"
    },
    {
      "id": "book-kamori-retrial",
      "number": 3,
      "status": "resolved",
      "anchor": "event-4ffa2e02398a23963aa1",
      "conclusion": "拒绝雇主的单方版本后取回头颅，恢复卡莫里的发言能力；信件、居所与神誓互证里奥多勾结盗贼栽赃。惩凶并实际改写史书完成昭雪，战马是旧主人临终托付的伙伴，不是无来由的怪物掉落。此支线独立起点与独立收束，不需要硬接王室政变。"
    },
    {
      "id": "book-demon-ring-politics",
      "number": 4,
      "status": "partial",
      "anchor": "event-31bad3bdaa157943837d",
      "conclusion": "鉴定绑定给出三系天赋，共鸣与魔化引来觊觎；引导100%会夺舍，保留意识等待神罚才解咒。旧鉴定师后来确为马尔都克，王杀政变者后赠缺失附件，四附件合成魔神戒并在后段实升神器。卡尔洛斯是融合的戒灵而非可直接战斗的额外强者。七功勋遗物作为异界钥匙的传说未完整开启，经验吸取比例冲突、早期动机与圆图细节没有被一概抹平。"
    },
    {
      "id": "book-arland-father",
      "number": 5,
      "status": "resolved",
      "anchor": "event-fbc95153f22082c39050",
      "conclusion": "王赠缺失遗物时暂缓身份答案，328/329对应单元直接认父并解释天下公司股东、工作人员扮NPC与维护职责；后续公爵奖和父亲萧寒安排现实重逢深化关爱。这是确证身份，不能再列为未知；也不能倒填每句早期心理或把父亲解释成能任意改规则。封爵公平措辞冲突仍是局部异常。"
    }
  ],

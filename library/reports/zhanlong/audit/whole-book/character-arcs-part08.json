    {
      "audit_id": "character-arc-043",
      "name": "TOM／刘蔚／洛鸣（技术说明与NPC原型接口）",
      "entity_type": "technology_and_character_prototype_interface",
      "component_entities": [
        {
          "name": "TOM",
          "role": "技术开发部门总监，现场说明者"
        },
        {
          "name": "刘蔚",
          "role": "研发部副总监，被TOM指为佩儿技术性格合成来源"
        },
        {
          "name": "洛鸣",
          "role": "兰州军区少将，被TOM指为洛浅林记忆衍生来源"
        }
      ],
      "initial_comparison_stage": "1352会餐由欧阳介绍TOM为技术开发总监，他自称用低级小号混入斩龙分盟；随后口述刘蔚和洛鸣的技术来源。这是三个现实实体的一组来源接口，不是三个别名、一人三职，亦不硬计为三条完整人物成长弧。",
      "key_decisions": "TOM选择向主、林、东解释记忆生成衍生，将早期NPC性格描写接到真人记忆技术；点出佩儿来自副总监刘蔚、浅林来自洛鸣少将，却因保密拒说流霜和希芙原型。研发方提出在游戏重建雷沈，公司要求死者亲属授权后才动数据；刘蔚/洛鸣未在此现场独立说话，其意愿不得由TOM代填。",
      "costs": "保密使部分NPC原型仍未揭；技术复现无法恢复现实肉身，剩余记忆可衍生也不消除主对数据还是生命的疑问。公司70%以上真实度说法未交可独立检验的记忆清册，不能替三人补研发牺牲史、心理转变或科学认证。",
      "terminal_state": "TOM保持技术说明者位置，刘蔚与洛鸣只以具名原型来源获得有限确认；未给他们死亡、变成NPC或亲自进入人物身体的场景。最终白墨颜记忆角色确醒，证明方案有个案实现，不证明所有NPC均与真人灵魂同一或雷已同等醒来。",
      "evidence_boundaries": "原型映射是TOM明确口述，不把佩儿故事内原魂/西瓦娜借体冲突改成现实刘蔚本人施暴，也不把浅林皇权行动全记洛鸣现实责任。TOM的粉丝小号未具名，不配给现有玩家ID；流霜/希芙原型未披露须留空。",
      "review_status": "draft",

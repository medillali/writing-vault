    {
      "audit_id": "character-arc-r3-060",
      "name": "兰斯",
      "roster_onebased_index": 60,
      "initial_comparison_stage": "兰蔻祖父兰斯，天境下界猎奴，和孙女靠打猎缴贡维生；不与龙族或弗雷类近音人物合并。",

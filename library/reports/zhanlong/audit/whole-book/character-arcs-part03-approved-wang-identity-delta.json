  "changes": [
    {
      "path": [
        "characters",
        3,
        "key_decisions"
      ],
      "before": "接受主纠错、守后队与吸火任务，作为一分领袖承担组织分工。现实照护秦雨，500表白获‘现在不能’的暂拒；658/659与星痕现实台球和互给ID，734她称王为男友才有后证，不能停在早恋情未知。后多次骑兵突击、护炮撤退与情报转述，获断海等装备后仍与多人轮锋；956列斩龙殿第七，二国战被玫瑰杀后继续战线。",
      "after": "接受主纠错、守后队与吸火任务，作为一分领袖承担组织分工。658/659与星痕现实台球和互给ID，734她称王翦为男友，确立这条关系后证；499—500照护秦雨并表白的是独立玩家王将，不属于王翦。后多次骑兵突击、护炮撤退与情报转述，获断海等装备后仍与多人轮锋；956列斩龙殿第七，二国战被玫瑰杀后继续战线。"
    },
    {
      "path": [
        "characters",
        3,
        "costs"
      ],
      "before": "冲阵、护后和被强敌集中击杀带来游戏死亡与掉级；装备资格不能被分配意图跳过。对秦雨的愿等不等她承诺，后与星痕关系必须按新证更新，也不擅补分手、争执或性交细节。",
      "after": "冲阵、护后和被强敌集中击杀带来游戏死亡与掉级；装备资格不能被分配意图跳过。与星痕关系按734称谓及后同住消息记录，不擅补分手、争执或性交细节；秦雨暂拒王将的代价不归王翦。"
    },
    {
      "path": [
        "characters",
        3,
        "terminal_state"
      ],
      "before": "仍为斩龙前线骨干和分路指挥，游戏死后持续返场；关系至少在734已确认星痕称其男友，卷四东城转述同住，终点没有专门否定或新婚证明。不得把秦雨与星痕合成一人，也不以听说同住宣现场亲见性关系。",
      "after": "仍为斩龙前线骨干和分路指挥，游戏死后持续返场；关系至少在734已确认星痕称王翦男友，卷四东城转述同住，终点没有专门否定或新婚证明。王将对秦雨的情感线不归王翦，也不以听说同住宣现场亲见性关系。"
    },
    {
      "path": [
        "characters",
        3,
        "evidence_boundaries"
      ],
      "before": "玩家王翦与NPC军将分域；甲剑取得、穿戴和后续更换按时点。战场情报转述不作他亲见所有幕后。关系由暂拒到另一明确对象后证，保渠道与阶段，不以早开放问题永久冻结终态。",
      "after": "玩家王翦与NPC军将分域；甲剑取得、穿戴和后续更换按时点。战场情报转述不作他亲见所有幕后。王将与王翦有499同句互指及445/1199同场分职业证；734王翦与星痕的关系独立成立，不把500王将的暂拒误排为王翦前段恋情。"
    },

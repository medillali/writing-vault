  "content": {
    "summary": "孤坟把友谊、资源交易和势力自主同时带进主线。他能帮助雪月，也会保留秋雨与亲属关系的利益；人物的可信处正在于不是无条件输送资源。",
    "上游人物审计": "character-arc-38",
    "人物": "孤坟",
    "原文事实与研究解释": "来源人物研究；事件与身份保留证据，性格、心理、分幕与创作方法为研究综合，待用户取舍。",
    "完整人物档案": {
      "acts": [
        {
          "context": "各会建立据点并争取发展空间。",
          "development": "协助资源、协调借用，与购买秋风镇等行动并行。",
          "outcome": "关系具有实惠与互惠基础，同时保留各会的所有权和利益。",
          "title": "资源互助积累人情"
        },
        {
          "context": "更大国战与CGL等社会位置进入叙事。",
          "development": "在联盟中协调，私下谈及名额安排，又为远亲荀方介入事务。",
          "outcome": "其私述是信息来源，不能当全部机构流程已经公开核实。",
          "title": "联盟与私人渠道交错"
        },
        {
          "context": "荀方的追求和竞争已经造成冲突。",
          "development": "施压其删除旧号，后又提供市场主管岗位；继续参与冰狼防务和国战。",
          "outcome": "既没有无条件支持侄辈，也没有因一次冲突把亲缘从人生中删除。",
          "title": "劝阻与提供退路"
        }
      ],
      "audit_id": "character-arc-38",
      "background": "他不是雪月内部成员的放大版。早期协助与交易累积人情，后续城市竞争、联盟与亲属介入逐渐显示其独立位置。把这些放在一起，才看得出老盟友也要处理多重责任。",
      "craft": "可靠盟友也可以有自己的边界。把帮助写成有成本、有对象、有其他牵挂的行动，联盟就不会沦为主角随用随到的资源仓库。",
      "identity": {
        "组织与亲缘": "秋雨重要领袖、中国联盟的重要合作者；荀方为其远房侄辈，亲缘由相关对话披露。",
        "资源与生活": "有能力购买据点、协调资源和提供职位；不据此估算个人总资产、固定收入或家庭全貌。"
      },
      "interpretation_status": "来源人物研究；事件与身份保留证据，性格、心理、分幕与创作方法为研究综合，待用户取舍。",
      "knowledge": [
        "CGL内定属于孤坟的私下说法；利用荀方打压雪月属于主角揣测，分别保留。"
      ],
      "limits": "亲缘、职位与交易有具体来源；未确认的操盘动机、总资产和制度内幕不扩写为定论。",
      "memories": [],
      "method": "整合既有八卷阅读、全书审计与本轮定点复核；不是声明本轮重新逐章通读。",
      "name": "孤坟",
      "personality": {
        "优势": "在大规模公共行动中提供资源和领导，帮助并非只有口头认同。",
        "核心特质": "务实、善协调，能够把私人熟悉与组织计算放在同一关系里。",
        "缺陷与张力": "亲属、旧友和本会利益可能冲突；他的私下说法与叙述者猜测不能全部当作客观真相。"
      },
      "possessions": [
        "秋风镇等组织据点：买地与防务带来实际资源，也意味着需要独立维护的利益。",
        "人情与职位：借资源、介绍事务、后来给荀方工作，都显示其社会网络持续存在。"
      ],
      "psychology": {
        "agenda": "维护本会立足与公共联盟，同时处理旧友和远亲的请求。",
        "complexity": "帮助书生不等于必须牺牲全部亲属与组织关系；但多边安排也可能损耗信任。",
        "trauma": "没有可确认的个人核心创伤，不以老练反推悲惨身世。"
      },
      "relationships": [
        {
          "analysis": "友谊、人情、交易和城市竞争交错，可以亲近但仍需谈条件。",

              "start_line": 126555
            },
            {
              "chapter_id": "ch-1180",
              "claim_kind": "fact",
              "end_line": 126639,
              "revision": "2c541951301de981c755ebf4001bf3ec909d1e7d44314e14fa8af51751849a52",
              "source_id": "src-2a13958390274509b2af019f6b12d981",
              "start_line": 126624
            },
            {
              "chapter_id": "ch-1181",
              "claim_kind": "fact",
              "end_line": 126745,
              "revision": "2c541951301de981c755ebf4001bf3ec909d1e7d44314e14fa8af51751849a52",
              "source_id": "src-2a13958390274509b2af019f6b12d981",
              "start_line": 126739
            }
          ],
          "outcome": "她活过终战。半年后菲雅领军、安妮为上将，救回者重新成为抵抗体系的一部分。结尾证明她继续服务联盟，却没有替她与林克安排跨越死亡的重逢，也没有宣告整个战争结束。",
          "range": "第1169—1173章",
          "title": "第五幕：从救援对象成为仍会受伤的同盟"
        }
      ],

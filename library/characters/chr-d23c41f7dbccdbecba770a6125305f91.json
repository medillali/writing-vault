{
  "asset_id": "chr-d23c41f7dbccdbecba770a6125305f91",
  "asset_type": "character",
  "content": {
    "summary": "勇敢的心／艾妮由法国区强敌转为有限合作伙伴，后来进入中国账号体系、追随冰茶并继续跨区协作。她的选择受妹妹、组织和局部承诺共同影响，不能用国别一次性规定忠敌。",
    "上游人物审计": "character-arc-45",
    "人物": "勇敢的心／艾妮",
    "原文事实与研究解释": "来源人物研究；事件与身份保留证据，性格、心理、分幕与创作方法为研究综合，待用户取舍。",
    "完整人物档案": {
      "acts": [
        {
          "context": "国际争夺使个人战力与地区立场高度显眼。",
          "development": "争BOSS、参与武器战，又为妹妹自降三级，形成局部个人停战。",
          "outcome": "停战边界明确，不能扩大成全法国区停止敌对。",
          "title": "强敌与有限停战"
        },
        {
          "context": "冰茶与新的组织条件提供另一种参与方式。",
          "development": "转中国账号、跟随冰茶，成为香草的重要骨干，同时保留法国协作。",
          "outcome": "游戏归属改变，法律身份与全部旧关系未被改写。",
          "title": "选择新的共同体"
        },
        {
          "context": "阵法、通缉和跨区战事要求盟友承担实际风险。",
          "development": "参与毁阵、保护被通缉者等行动，承担战斗与组织损失。 后期明确进入炼狱神殿，成为天域强者。",
          "outcome": "合作通过具体选择成立，炼狱天域已有明确交代；私人婚姻与永久退游仍无完整终点。",
          "title": "用高风险行动确认关系"
        }
      ],
      "audit_id": "character-arc-45",
      "background": "她先作为争夺BOSS与国际武器竞争中的对手出现。救妹、局部停战及与冰茶关系推动后续转向，这使合作有私人基础，也保留了原地区更复杂的多方意志。",
      "craft": "跨阵营人物的可信度来自承诺范围清楚。让她为某个人付出真实代价，同时仍无法控制整个旧阵营，合作就保有张力。",
      "identity": {
        "末段境界": "末段已进入炼狱神殿，取得天域状态；ch-1174明确列名并再次叙述飞升，不能沿用旧审计的未证边界。",
        "称谓与身份": "勇敢的心，本名艾妮；海洋之心的姐妹关系在行动中具有明确分量。",
        "账号与归属": "后转中国账号并与冰茶共同活动，仍有法国合作关系。游戏区服变更不是法律国籍变更。"
      },
      "interpretation_status": "来源人物研究；事件与身份保留证据，性格、心理、分幕与创作方法为研究综合，待用户取舍。",
      "knowledge": [
        "个人承诺、账号转换和地区整体政策分层，不拿其他人的敌对行为给她追加未证实的背约。"
      ],
      "limits": "区服不等于国籍，局部停战不等于地区和平。天域已在末段明确，未展示的婚姻与退游不补写。",
      "memories": [
        "为救妹妹自降三级，是已经付出的个人成本；不扩写未见的感官独白。"
      ],
      "method": "整合既有八卷阅读、全书审计与本轮定点复核；不是声明本轮重新逐章通读。",
      "name": "勇敢的心／艾妮",
      "personality": {
        "优势": "能在复杂战局中协作、毁阵和保护通缉中的伙伴，不只为自己得分。",
        "张力": "个人停战只能约束自己的行动，无法替整个地区承诺；继续存在的跨区追杀不必全解释为她背叛。",
        "核心特质": "敢于正面对抗，也会为具体的人和承诺作出跨阵营选择。"
      },
      "possessions": [
        "账号与组织位置：跨区选择带来行动条件变化，不意味着所有法国玩家都与她同进退。",
        "为救妹妹付出的等级：自降三级是已经发生的代价，不因后来合作而消失。"
      ],
      "psychology": {
        "agenda": "早期争取己方利益，涉及妹妹时愿付个人代价；后期维持新的伙伴承诺与仍在的跨区关系。",
        "complexity": "同一人可以在不同事务上保有不同承诺，不能要求一次合作就代表全部旧关系消失。",
        "trauma": "未有足够材料确认独立核心创伤，不以跨区转移补造政治迫害或家庭决裂。"
      },
      "relationships": [
        {
          "analysis": "妹妹是她愿意付出等级的具体对象，家庭关系直接改变行动。",
          "person": "海洋之心"
        },
        {
          "analysis": "新的共同体与信任关系通过追随、任职和共战落实。",
          "person": "冰茶"
        },
        {
          "analysis": "与书生可以停战合作，但不代表她能为全部法国玩家作主。",
          "person": "书生及法国玩家"
        }
      ]
    },
    "档案版本": 2,

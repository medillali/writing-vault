  "content": {
    "constraints": [
      "政治/军力时间、受伤、不能吃普通牧师复活。"
    ],
    "decisions": [
      "安葬旧王、援城、亲授奥丹第九统帅；达尔战重伤仍拔戟反刺造最后窗口。"
    ],
    "goals": [
      "重建城市、护民和军队。"
    ],
    "knowledge_boundary": "仅记录卷七已发生；系统/本人自述/旁人转述/主角猜测区分；尾段由primary实读。",
    "relationship_directions": [
      "冰兰协作；林丘与茉莉忠诚但有独立动机；对书给有限军事权不是任统帅。"
    ],
    "stage_change": "达尔后仍活；不能把系统算书击杀当她未贡献，亦不能把所有招兵三日成熟作无条件。",
    "summary": "从收复旧城的公主到组织军团、授奥丹职与亲战达尔。"
  },

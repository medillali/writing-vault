  "content": {
    "constraints": [
      "旧恩与新共同体牵扯；暗恋动机未由其本人明确证实。"
    ],
    "decisions": [
      "带旧部离，曾违林阻偷援晚；战魂国战/暮色九波牺牲、救通缉者。"
    ],
    "goals": [
      "守旧组织与林霜、维持兄弟关系。"
    ],
    "knowledge_boundary": "仅记录卷七已发生；系统/本人自述/旁人转述/主角猜测区分；尾段由primary实读。",
    "relationship_directions": [
      "书当面允离、仍兄弟；林霜承误认役使。书劝她珍惜龙魂，她未明确接受；勿以此证实龙魂全部内心。"
    ],
    "stage_change": "已属战魂不回填雪会籍；迟到援助/长期支持分别记，不用道歉消除当初组织损失。",
    "summary": "龙魂自述因旧日回忆返战魂，仍多次实际守国/援旧友；刑天另有母亲重病时的嘱托，暗恋林霜则是书生推断。"
  },

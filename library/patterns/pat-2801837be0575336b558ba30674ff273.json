  "content": {
    "applicability": "当个人能高光但不能控制全部制度结果时。",
    "causal_steps": [
      "先列主目标与其他主体目标",
      "逐项指定结算渠道",
      "按系统/现场分别关闭",
      "保仍未达的目标进入下一段"
    ],
    "claim_kind": "synthesis",
    "failure_mode": "用主MVP代所有人胜，或用全城奖恢复抹死者。",
    "originality_transform": "改成不同制度和非军事实体：项目成功/病人获救/家庭负债各由不同人承担。",
    "summary": "战役胜、个人名次、城权、具名死亡和恢复可同时异向。"
  },

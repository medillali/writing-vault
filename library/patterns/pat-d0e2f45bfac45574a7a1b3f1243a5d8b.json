  "asset_type": "pattern",
  "content": {
    "applicability": "角色重聚与组织成长同线",
    "boundary": "研究者抽象，不是用户审美定案或原创世界设定；不能把人物的民族贬辞、物化和牺牲美化自动迁移。",
    "causal_steps": [
      "失核心不是只少人数，还少领导/覆盖",
      "量招不能立刻补质量",
      "回归强者先作为陌生敌色出现",
      "通过制度/行为贡献取得正式位置",
      "仍需友盟规模支援"
    ],
    "failure_mode": "把回归写免手续/免冲突，或一强者替代全部基础队伍",
    "originality_transform": "换地域与组织规则，回归者须有自主目标和证明，避免旧人掀罩即归位。",
    "summary": "组织缺口与回归者的身份障碍同时解决"
  },

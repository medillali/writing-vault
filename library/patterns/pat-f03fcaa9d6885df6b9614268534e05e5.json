  "content": {
    "applicability": "能力强但存在友军/射线/覆盖边界的多线战。",
    "causal_steps": [
      "把两个威胁放在不同位置",
      "让同一工具对一方有效而另一方危险",
      "分派不同队伍处理",
      "保支援后仍有人损"
    ],
    "claim_kind": "synthesis",
    "failure_mode": "只用更大伤害解全部，或忘记已有强炮无解释。",
    "originality_transform": "用法律证据、医疗隔离或救援设备做空间/权限分工。",
    "summary": "炮能轰密兵却不能轰混战神骨，通过转换目标找回价值。"
  },

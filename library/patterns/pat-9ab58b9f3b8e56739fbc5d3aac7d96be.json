  "asset_type": "pattern",
  "content": {
    "applicability": "长线成长、基地经营与军团战互相咬合",
    "boundary": "研究者抽象，不是用户审美定案或原创世界设定；不能把人物的民族贬辞、物化和牺牲美化自动迁移。",
    "causal_steps": [
      "先承受怪/技能的痛",
      "得到宠/蛋/技能或复制资格",
      "资源、工匠、每日配额限制规模",
      "在后战用组合而非同一单技解决问题"
    ],
    "failure_mode": "奖励到手立即无限使用，或成年前神龙提前飞骑",
    "originality_transform": "重造兵种和经营代价，保先验威胁→有限改造→组织部署，不复制鬼车/龙曜名字数表。",
    "summary": "威胁转资产后，经生产瓶颈回到军团实战"
  },

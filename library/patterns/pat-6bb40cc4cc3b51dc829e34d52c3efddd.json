  "content": {
    "applicability": "环境规则稳定且人物能观察",
    "causal_steps": [
      "侦察移动速度和同时接敌数",
      "选择/制造限制入口",
      "保留弱敌占格降低承伤",
      "用远程或治疗平衡收益",
      "遇可破障或过快敌时失效"
    ],
    "failure_mode": "环境对所有敌都永远有效",
    "literary_limits": "机制是研究抽象，非用户风格规则；原文偏见与代价需另审。",
    "originality_transform": "使用不同空间和物理机制，且给对手绕行或破坏能力。",
    "summary": "路径数量与弱敌占位：用可观察条件而非情节外壳组织因果。"

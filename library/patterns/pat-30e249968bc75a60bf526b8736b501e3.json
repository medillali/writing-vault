  "content": {
    "applicability": "离别/组织回流/恋人修复。",
    "causal_steps": [
      "损害具体化",
      "第一次接触仍允许拒绝",
      "承认谁被忽视/误认",
      "当事人付可见行动成本",
      "分阶段返回仍保边界"
    ],
    "failure_mode": "强制拉回或赠物就自动原谅；后来的亲密覆盖先前拒绝。",
    "originality_transform": "改变损害原因、回归条件与关系形式，确保独立人物目标，不照搬多伴侣安排。",
    "summary": "找到人不等对方愿返；同住、会籍和亲密各自确认。"
  },

  "content": {
    "applicability": "任务制剧情/经营主线",
    "boundary": "研究者抽象，不代表用户审美认可或原创设定。强制、性侵、民族/性别贬抑与酷刑不自动成为可学价值。",
    "causal_steps": [
      "分别列系统条件/委托目的/人物愿望",
      "让可见结算只答其中一项",
      "揭委托背后的控制欲或仍失人",
      "下一阶段承接未完成私人目标"
    ],
    "failure_mode": "拿一条完成公告洗掉所有死亡或伦理失败",
    "originality_transform": "重新设计相互不一致的目标、奖励与被救者自主选择",
    "summary": "系统任务成与人物目标不必同成"
  },

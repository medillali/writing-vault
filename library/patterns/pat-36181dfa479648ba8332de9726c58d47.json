  "content": {
    "applicability": "适合长期成长、需要避免纯战力碾压的情节。",
    "failure_mode": "若战后复活全部损失或下场恢复满状态，教训不成立。",
    "steps": [
      "给敌人可靠的局部情报和可行计划。",
      "让计划真实命中主角短板。",
      "主角反制取胜，但保留死亡、损伤与运输成本。",
      "后续判断显出学到的原则及尚会再犯的边界。"
    ],
    "summary": "让对手失败仍有效改变主角状态和下一步选择。",
    "volume": 10
  },

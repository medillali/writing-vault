  "asset_type": "pattern",
  "content": {
    "applicability": "团队培养、非战斗专长进入战斗。",
    "causal_steps": [
      "用具体失误确立弱项",
      "分出信息/节奏/后勤任务",
      "让强主角采纳其新信息并成功",
      "之后弱项仍会造成需人补救的代价"
    ],
    "claim_kind": "synthesis",
    "failure_mode": "若后续一律神准就会把早弱项虚化；不靠后卷身份反转倒解释当前。",
    "originality_transform": "使用不同专业的不对称专长，如导航/谈判/材料判断；不搬笨萌外貌和身材凝视。",
    "summary": "新人可动作拙却观察/规划强，贡献通过结果而非标签证明。"
  },

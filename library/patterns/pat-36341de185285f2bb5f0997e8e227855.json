  "content": {
    "applicability": "夺城、政治、竞赛、寻物类情节。",
    "causal_steps": [
      "确认此战实际目的",
      "列局部成功",
      "揭尚缺民心/物权/生存条件",
      "新的主体行动改归属",
      "用系统或现场确认最终状态"
    ],
    "failure_mode": "靠提示一句全成消掉其他条件；把转述写亲见。",
    "originality_transform": "原创项目另设权属与执行程序，不复刻杀实时城主机制。",
    "summary": "把杀死/破门与真正目标分开以保复杂后果。"
  },

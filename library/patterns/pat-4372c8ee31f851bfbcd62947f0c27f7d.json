{
  "asset_id": "pat-4372c8ee31f851bfbcd62947f0c27f7d",
  "asset_type": "pattern",
  "content": {
    "applicability": "背叛、复仇及赎罪线需避免一句感化",
    "boundary": "研究者抽象，不是用户审美定案或原创世界设定；不能把人物的民族贬辞、物化和牺牲美化自动迁移。",
    "causal_steps": [
      "明确早期死/濒死/误认的各层",
      "对立证词先并列留疑",
      "找到能改变其中一项的现场物证",
      "告别或身体代价不可被和解抹掉",
      "改阵营后仍有独立边界与物质成本"
    ],
    "failure_mode": "把反派受害史当免责、把净化复体当原未死",
    "originality_transform": "换真相载体/救赎条件，保责任不互消，避免重复母体修院/强剖龙心/血制剂。",
    "summary": "用可见证据与不可逆告别推进阵营改变"
  },

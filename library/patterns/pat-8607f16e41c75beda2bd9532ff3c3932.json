  "content": {
    "applicability": "目标确实不同且有独立结果。",
    "causal_steps": [
      "列出人物真正承诺和系统目标",
      "每项分别保可见判据",
      "允许不同方向的结果并存",
      "让后续责任承接未完成部分"
    ],
    "claim_kind": "synthesis",
    "failure_mode": "把所有结果并成一个胜利或拿奖励抹代价。",
    "originality_transform": "换成非游戏的职责/债务/政治指标，自定判据，避免复制倒计时护NPC或原比赛情节。",
    "summary": "同一战段可以护人成功而城破、守城失败却个人获奖、私赛胜而团队败。"

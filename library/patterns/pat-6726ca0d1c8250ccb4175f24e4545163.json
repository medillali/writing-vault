  "asset_id": "pat-6726ca0d1c8250ccb4175f24e4545163",
  "asset_type": "pattern",
  "content": {
    "applicability": "长篇需要阶段目标牵引",
    "causal_steps": [
      "提前取得无法当场使用的奖励",
      "明确使用条件或用途未知",
      "途中反复展示负担和期待",
      "达到条件实际装备/领用",
      "保留仍未解锁的物品与新代价"
    ],
    "failure_mode": "凡伏笔都立即开、未兑现写成完成",
    "literary_limits": "机制是研究抽象，非用户风格规则；原文偏见与代价需另审。",
    "originality_transform": "原创替换物件与资格机制，别复刻神珠/地器/首转链。",
    "summary": "延迟兑现而保留资源限制：用可观察条件而非情节外壳组织因果。"
  },

{
  "asset_id": "pat-000f38a585d5572893c5d5a75af408d1",
  "asset_type": "pattern",
  "content": {
    "applicability": "人物道德复杂而不是单纯英雄奖惩",
    "boundary": "研究者抽象，不是用户审美定案或原创世界设定；不能把人物的民族贬辞、物化和牺牲美化自动迁移。",
    "causal_steps": [
      "给出战略目标与向具体人的承诺",
      "倒计时/群体责任使二者不可兼得",
      "人物作选择并承认毁约或隐意",
      "胜利只结战略账，信任债继续驱动后续选择"
    ],
    "failure_mode": "用主痛苦/胜战抹实际背诺，或把牺牲神圣化免询问",
    "originality_transform": "创造双方都可理解的利益，不把敌国平民与普通兵当无名数字；显示被负者反馈。",
    "summary": "将任务成功与人际守诺分开结算"
  },

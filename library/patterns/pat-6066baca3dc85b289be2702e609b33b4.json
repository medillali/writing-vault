  "content": {
    "applicability": "主角有情感偏向且调查/政治信息分散的叙述。",
    "causal_steps": [
      "明确信息发言/取得者",
      "写能证范围",
      "让行动取得新证但保未证环",
      "更新而不抹旧推断"
    ],
    "claim_kind": "synthesis",
    "failure_mode": "让强烈语气自动变全知，或因证据不足否认已亲见袭击。",
    "originality_transform": "换成历史档案/职场事故，重新设计证据物、获证代价与误判。",
    "summary": "第一人称再确信，也需要独立后证才能改变责任结论。"
  },

  "content": {
    "applicability": "长线冒险/组织战有独立私人利益",
    "boundary": "研究者抽象，不代表用户审美认可或原创设定。强制、性侵、民族/性别贬抑与酷刑不自动成为可学价值。",
    "causal_steps": [
      "先兑现战斗奖励",
      "同时留下具体可行动损伤/死亡",
      "后续目标从领奖转为照护/寻人",
      "再大的系统结算也不抵消前代价"
    ],
    "failure_mode": "若伤只用来卖惨后无成本复原，代价失信",
    "originality_transform": "另造不同伤因、劳动与社会后果；不用原失腿/神格/排行榜",
    "summary": "战胜新增债务，奖赏不结清同伴代价"

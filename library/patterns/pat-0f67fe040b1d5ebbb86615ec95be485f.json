  "content": {
    "applicability": "记忆、替身、档案或数字人格故事。",
    "causal_steps": [
      "明确真实死亡后果",
      "由不同人提出授权反对与理由",
      "给技术能力的宣称限制",
      "实际只演已发生的复现，不替未演对象补结局"
    ],
    "failure_mode": "把复现当无条件现实复活，或用一次熟悉口吻证明同一人格。",
    "originality_transform": "可改为遗留录音和合作者新读法，让慰藉来自活人行动而非复制莲花醒来镜头。",
    "summary": "死者记忆复现可以给情感回报，同时保现实死亡与数据断裂。"
  },

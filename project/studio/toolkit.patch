+(() => {
+  'use strict';
+
+  const $ = (selector, root = document) => root.querySelector(selector);
+  const nodes = {
+    main: $('#main-content'), inspector: $('#inspector'), picker: $('#project-picker'),
+    nav: $('#main-nav'), chapters: $('#chapter-nav'), notice: $('#notice-region'),
+    sidebar: $('#sidebar'), backdrop: $('#sidebar-backdrop'), menu: $('#menu-toggle'),
+    file: $('#return-file'), breadcrumb: $('#breadcrumb'), export: $('#export-project'),
+  };
+  const state = {
+    projects: [], project: null, researchEnabled: false, page: 'overview', chapterId: null,
+    chapterTab: 'plan', editingCharacter: null, editingRule: null, creating: false,
+    busy: false, formCache: new Map(), research: [], researchQuery: '', searched: false,
+    searchBusy: false, packCache: new Map(), disabledButtons: [],
+  };

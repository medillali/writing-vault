+from fictionlib.vault import Vault
+
+
+class StudioTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.studio = Studio.init(self.root / 'private')
+        self.p = self.studio.create('虚构测试：渡灯', '守灯人查明停航原因。', '克制，重动作。')
+        self.pid = self.p['project_id']
+        self.act('character_upsert', name='阿澄', role='守灯人', voice='短句', baseline='未见过密信')
+        self.cid = self.p['characters'][0]['id']
+        self.act('chapter_upsert', number=1, title='灯熄', goal='发现假航标', pov=self.cid, cast=[self.cid], beats=['发现', '选择'])
+        self.ch = self.p['chapters'][0]['id']
+
+    def act(self, action, **payload):
+        self.p = self.studio.apply(self.pid, self.p['revision'], action, payload)
+        return self.p
+
+    def pack(self, ch=None):
+        ch = ch or self.ch
+        self.act('task_issue', chapter_id=ch)
+        return self.studio.pack(self.pid, ch)
+
+    def draft(self, text='阿澄读完密信，把灯移到西窗。', ch=None):
+        pack = self.studio.pack(self.pid, ch or self.ch)
+        payload = pack['return_template']['payload']
+        payload['text'] = text
+        self.act('draft_submit', **payload)
+        return self.studio.pack(self.pid, ch or self.ch)
+
+    def review(self, verdict='pass', ch=None, **extra):
+        pack = self.studio.pack(self.pid, ch or self.ch)
+        payload = pack['review_template']['payload']
+        payload.update(verdict=verdict, reviewer='测试审稿人', summary='阿澄发现假航标并转移灯火。', issues=[], memory=[])
+        payload.update(extra)
+        return self.act('review_submit', **payload)
+
+    def finish(self):
+        self.pack()
+        self.draft()
+        self.review(memory=[{'subject':self.cid,'text':'已经读过密信','quote':'阿澄读完密信'}])
+        self.act('finalize', chapter_id=self.ch)
+
+    def test_two_chapter_pipeline_uses_only_final_memory(self):
+        self.finish()
+        self.assertEqual(self.p['chapters'][0]['status'], 'finalized')
+        self.act('chapter_upsert', number=2, title='潮声', goal='验证线索', pov=self.cid, cast=[self.cid], beats=['试探'])
+        ch2 = self.p['chapters'][1]['id']
+        pack = self.pack(ch2)
+        self.assertIn('已经读过密信', json.dumps(pack['context'], ensure_ascii=False))
+        self.draft('阿澄带着灯，走上码头。', ch2)
+        self.review(ch=ch2)
+        self.act('finalize', chapter_id=ch2)
+        self.assertEqual(self.p['progress']['finalized'], 2)
+        self.assertGreater(self.p['progress']['words'], 0)
+        self.assertGreater(len(list((self.studio.root / 'history/studio' / self.pid).glob('*.json'))), 5)
+
+    def test_future_rules_and_unfinalized_proposals_never_leak(self):
+        self.act('rule_upsert', text='第三章才揭示的秘密', from_chapter=3)
+        pack = self.pack()
+        self.assertNotIn('第三章才', json.dumps(pack['context'], ensure_ascii=False))
+        self.draft()
+        self.review(memory=[{'subject':self.cid,'text':'已经读过密信','quote':'阿澄读完密信'}])
+        self.act('chapter_upsert', number=2, title='后章', goal='试探', pov=self.cid, cast=[self.cid], beats=['试探'])
+        with self.assertRaisesRegex(ValueError, '前章'):
+            self.pack(self.p['chapters'][1]['id'])
+
+    def test_new_draft_requires_fresh_review_and_rejects_old_base(self):
+        self.pack()
+        old = self.draft()
+        self.review()
+        self.draft('阿澄读完密信，把灯放到门外。')
+        with self.assertRaisesRegex(ValueError, '审稿'):
+            self.act('finalize', chapter_id=self.ch)
+        payload = old['return_template']['payload']
+        payload['text'] = '覆盖别人的新稿'
+        with self.assertRaisesRegex(ValueError, '稿件版本'):
+            self.act('draft_submit', **payload)
+
+    def test_prior_revision_invalidates_downstream_final_and_late_returns(self):
+        self.finish()
+        self.act('chapter_upsert', number=2, title='潮声', goal='验证线索', pov=self.cid, cast=[self.cid], beats=['试探'])
+        ch2 = self.p['chapters'][1]['id']
+        old = self.pack(ch2)
+        self.draft('灯在风中闪烁。', ch2)
+        self.review(ch=ch2)
+        self.act('finalize', chapter_id=ch2)
+        self.act('chapter_upsert', id=self.ch, number=1, title='灯熄', goal='改为拒绝信使', pov=self.cid, cast=[self.cid], beats=['拒绝'])
+        self.assertEqual([c['status'] for c in self.p['chapters']], ['stale','stale'])
+        self.assertEqual(self.p['progress']['finalized'], 0)
+        payload = old['return_template']['payload']
+        payload['text'] = '旧任务回来的正文'
+        with self.assertRaisesRegex(ValueError, '过期'):
+            self.act('draft_submit', **payload)
+
+    def test_pass_cannot_hide_blocking_issue_or_invent_memory_evidence(self):
+        self.pack()
+        self.draft()
+        with self.assertRaisesRegex(ValueError, '阻断'):
+            self.review(issues=[{'severity':'major','description':'因果跳跃','quote':'移到西窗'}])
+        with self.assertRaisesRegex(ValueError, '原句'):
+            self.review(memory=[{'subject':self.cid,'text':'获得神力','quote':'不存在的句子'}])
+        self.review('revise', issues=[{'severity':'major','description':'补选择动机','quote':'移到西窗'}])
+        self.assertEqual(self.p['chapters'][0]['status'], 'revise')
+
+    def test_old_review_cannot_override_new_blocking_review(self):
+        self.pack()
+        package = self.draft()
+        old = package['review_template']['payload']
+        old.update(verdict='pass',reviewer='旧审稿人',summary='旧结论',issues=[],memory=[])
+        self.review('revise',issues=[{'severity':'major','description':'补动机','quote':'移到西窗'}])
+        with self.assertRaisesRegex(ValueError, '审稿版本冲突'):
+            self.act('review_submit',**old)
+        self.assertEqual(self.studio.get(self.pid)['chapters'][0]['status'],'revise')
+
+    def test_reissue_carries_old_text_but_not_old_approval(self):
+        self.finish()
+        self.act('chapter_upsert',id=self.ch,number=1,title='灯熄',goal='补充选择的代价',pov=self.cid,cast=[self.cid],beats=['付出代价'])
+        package = self.pack()
+        self.assertEqual(package['current_draft']['text'],'阿澄读完密信，把灯移到西窗。')
+        self.assertIsNone(package['current_review'])
+        self.assertEqual(package['previous_review']['verdict'],'pass')
+        with self.assertRaisesRegex(ValueError,'审稿'):
+            self.act('finalize',chapter_id=self.ch)
+
+    def test_revision_conflict_and_private_git_guard(self):
+        with self.assertRaisesRegex(ValueError, '版本冲突'):
+            self.studio.apply(self.pid, 1, 'update_project', {'brief':'旧窗口覆盖'})
+        repo = self.root / 'public-repo'
+        repo.mkdir()
+        (repo / '.git').mkdir()
+        with self.assertRaisesRegex(ValueError, 'Git'):
+            Studio.init(repo / 'novel-data')
+
+    def test_reference_is_pinned_not_canon(self):
+        v = Vault.init(self.root / 'research')
+        card = v.put_asset({'asset_type':'pattern','scope':'reusable-pattern','title':'代价推动选择','tags':[],
+                           'content':{'summary':'选择需付出代价'},'evidence':[]})
+        self.p = self.studio.pin_reference(self.pid, self.p['revision'], v.root, card['asset_id'], card['revision'])
+        self.assertEqual(self.p['references'][0]['hash'], __import__('fictionlib.storage',fromlist=['digest']).digest(card))
+        pack = self.pack()
+        self.assertEqual(pack['context']['rules'], [])
+        self.assertEqual(pack['context']['references'][0]['scope'], 'reusable-pattern')
+
+    def test_edit_preserves_existing_vault_project_references(self):
+        card = self.studio.vault.put_asset({'asset_type':'pattern','scope':'reusable-pattern','title':'测试机制','tags':[],
+                                            'content':{'summary':'付出代价'},'evidence':[]})
+        original = self.studio.vault.use_asset(self.pid,card['asset_id'])

+"""Private, versioned chapter production. No model calls or inferred story facts."""
+
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from .storage import atomic_write, commit, digest, json_text, locked, new_id, read_json, safe_path
+from .vault import Vault, identifier, now, require_text
+
+
+def private_path(path):
+    root = Path(path).expanduser().resolve()
+    if any((parent / '.git').exists() for parent in (root, *root.parents)):
+        raise ValueError('私人作品目录不能位于 Git 仓库内；请使用独立目录')
+    return root
+
+
+def default_path():
+    return Path(os.environ['LOCALAPPDATA']) / 'NovelStudio' if os.name == 'nt' and os.environ.get('LOCALAPPDATA') else Path.home() / '.local/share/novel-studio'
+
+
+def _text(value, field, limit=100000, empty=False):
+    if empty and value == '':
+        return value
+    require_text(value, field, limit)
+    return value
+
+
+def _number(value, field):
+    if type(value) is not int or not 1 <= value <= 100000:
+        raise ValueError(field + ' 必须是 1–100000 的整数')
+    return value
+
+
+def _list(value, field, limit=1000):
+    if not isinstance(value, list) or len(value) > limit:
+        raise ValueError(field + ' 必须是列表且长度不超过 ' + str(limit))
+    return value
+
+
+def _find(records, key):
+    identifier(key)
+    for record in records:
+        if record['id'] == key:
+            return record
+    raise ValueError('记录不存在: ' + key)
+
+
+def _draft(chapter):
+    task = chapter['tasks'][-1] if chapter['tasks'] else None
+    return next((d for d in reversed(chapter['drafts']) if task and d['task_id'] == task['id']), None)
+
+
+def _review(chapter, draft):
+    return next((r for r in reversed(chapter['reviews']) if draft and r['draft_hash'] == draft['hash'] and r['task_id'] == draft['task_id']), None)
+
+
+def _contexts(project):
+    """Compute in order: invalid earlier finals cannot remain in later memory."""
+    result, previous = {}, []
+    for ch in sorted(project['chapters'], key=lambda c: c['number']):
+        context = {
+            'project': {'title':project['title'], 'brief':project['brief'], 'style':project['style']},
+            'chapter': {k:ch[k] for k in ('id','number','title','goal','pov','cast','beats')},
+            'characters': [c for c in project['characters'] if c['id'] in ch['cast']],
+            'rules': [r for r in project['rules'] if r['from_chapter'] <= ch['number']],
+            'references': project['references'],
+            'previous_chapters': copy.deepcopy(previous),
+        }
+        context_hash = digest(context)
+        task = ch['tasks'][-1] if ch['tasks'] else None
+        draft = _draft(ch)
+        review = _review(ch, draft)
+        ready = all(p['finalized'] for p in previous)
+        stale = bool(task and (task['context_hash'] != context_hash or not ready))
+        final = ch.get('final')
+        valid_final = bool(not stale and task and draft and review and review['verdict'] == 'pass' and final
+                           and final['task_id'] == task['id'] and final['draft_hash'] == draft['hash']
+                           and final['review_id'] == review['id'])
+        status = ('stale' if stale else 'finalized' if valid_final else
+                  'reviewed' if review and review['verdict'] == 'pass' else 'revise' if review else
+                  'draft' if draft else 'ready' if task else 'planned')
+        result[ch['id']] = {'context':context, 'context_hash':context_hash, 'ready':ready, 'status':status,
+                            'current_task':task, 'current_draft':draft, 'current_review':review}
+        previous.append({'id':ch['id'], 'number':ch['number'], 'title':ch['title'], 'finalized':valid_final,
+                         'draft_hash':draft['hash'] if valid_final else None,
+                         'summary':review['summary'] if valid_final else '',
+                         'memory':copy.deepcopy(review['memory']) if valid_final else []})
+    return result
+
+
+def decorated(project):
+    result = copy.deepcopy(project)
+    contexts = _contexts(project)
+    for ch in result['chapters']:
+        ch.update({k:contexts[ch['id']][k] for k in ('status','current_task','current_draft','current_review')})
+    result['chapters'].sort(key=lambda c:c['number'])
+    result['progress'] = {'total':len(result['chapters']),
+                          'finalized':sum(c['status'] == 'finalized' for c in result['chapters']),
+                          'drafted':sum(bool(c['drafts']) for c in result['chapters']),
+                          'words':sum(len(''.join(c['current_draft']['text'].split())) for c in result['chapters'] if c['status'] == 'finalized')}
+    return result
+
+
+class Studio:
+    def __init__(self, path):
+        self.root = private_path(path)
+        self.vault = Vault(self.root)
+
+    @classmethod
+    def init(cls, path):
+        root = private_path(path)
+        Vault.init(root)
+        return cls(root)
+
+    def _read(self, pid):
+        return read_json(safe_path(self.root, f'books/{identifier(pid)}/studio.json'))
+
+    def _save(self, p):
+        p['revision'] += 1
+        p['updated_at'] = now()
+        pid = p['project_id']
+        text = json_text(p)
+        project_path = safe_path(self.root,f'books/{pid}/project.json')
+        base = read_json(project_path) if project_path.exists() else {'schema_version':1, 'project_id':pid,
+                'status':'active', 'assets':[], 'created_at':p['created_at']}
+        base['title'] = p['title']
+        commit(self.root, {f'books/{pid}/studio.json':text,
+                           f'history/studio/{pid}/{p["revision"]:08}.json':text,
+                           f'books/{pid}/project.json':json_text(base)})
+        return decorated(p)
+
+    def create(self, title, brief='', style=''):
+        _text(title,'书名',500)
+        _text(brief,'故事定位',empty=True)
+        _text(style,'文风',empty=True)
+        p = {'schema_version':1, 'project_id':new_id('proj'), 'title':title, 'brief':brief, 'style':style,
+             'revision':0, 'created_at':now(), 'characters':[], 'rules':[], 'references':[], 'chapters':[]}
+        with locked(self.root):
+            return self._save(p)
+
+    def list(self):
+        with locked(self.root):
+            return [{'project_id':p['project_id'],'title':p['title'],'revision':p['revision']}
+                    for _, p in self.vault._records('books/*/studio.json')]
+
+    def get(self, pid):
+        with locked(self.root):
+            return decorated(self._read(pid))
+
+    def _check(self, pid, revision):
+        p = self._read(pid)
+        if type(revision) is not int or p['revision'] != revision:
+            raise ValueError('项目版本冲突，请刷新并保留本地输入后重试')
+        return p
+
+    def apply(self, pid, revision, action, data):
+        if not isinstance(data, dict):
+            raise ValueError('payload 必须是对象')
+        actions = {'update_project','character_upsert','rule_upsert','chapter_upsert','task_issue',
+                   'draft_submit','review_submit','finalize'}
+        if action not in actions:
+            raise ValueError('未知操作: ' + str(action))
+        with locked(self.root):
+            p = self._check(pid,revision)
+            getattr(self, '_' + action)(p,data)
+            return self._save(p)
+
+    def _update_project(self,p,d):
+        for key, limit in [('title',500),('brief',100000),('style',100000)]:
+            if key in d:
+                p[key] = _text(d[key],key,limit,empty=key != 'title')
+
+    def _character_upsert(self,p,d):
+        record = _find(p['characters'], d['id']) if d.get('id') else {'id':new_id('char')}
+        record.update({k:_text(d.get(k,''),k,empty=k != 'name') for k in ('name','role','voice','baseline')})
+        if not d.get('id'):
+            p['characters'].append(record)
+
+    def _rule_upsert(self,p,d):
+        record = _find(p['rules'],d['id']) if d.get('id') else {'id':new_id('rule')}
+        record.update(text=_text(d['text'],'世界规则'), from_chapter=_number(d['from_chapter'],'生效章节'))
+        if not d.get('id'):
+            p['rules'].append(record)
+
+    def _chapter_upsert(self,p,d):
+        number = _number(d['number'],'章节序号')
+        if any(c['number'] == number and c['id'] != d.get('id') for c in p['chapters']):
+            raise ValueError('章节序号重复')
+        cast = _list(d.get('cast',[]),'出场人物')
+        if len(cast) != len(set(cast)):
+            raise ValueError('出场人物重复')
+        for cid in cast:
+            _find(p['characters'],cid)
+        beats = _list(d.get('beats',[]),'章节节拍')
+        for beat in beats:
+            _text(beat,'节拍')
+        record = _find(p['chapters'],d['id']) if d.get('id') else {'id':new_id('ch'),'tasks':[], 'drafts':[], 'reviews':[], 'final':None}
+        record.update(number=number, cast=copy.deepcopy(cast), beats=copy.deepcopy(beats))
+        record.update({k:_text(d[k],k) for k in ('title','goal','pov')})
+        if not d.get('id'):
+            p['chapters'].append(record)
+
+    def _task_issue(self,p,d):
+        ch = _find(p['chapters'],d['chapter_id'])
+        computed = _contexts(p)[ch['id']]
+        if not computed['ready']:
+            raise ValueError('前章尚未有效定稿，先完成或修订前章')
+        if not p['brief'].strip():
+            raise ValueError('派稿前请填写故事定位')
+        if len(ch['tasks']) >= 1000:
+            raise ValueError('任务历史已达上限，请建立新项目')
+        ch['tasks'].append({'id':new_id('task'),'context_hash':computed['context_hash'],
+                            'context':computed['context'],'previous_review':computed['current_review'],'created_at':now()})
+        if computed['current_draft']:
+            old = computed['current_draft']
+            ch['drafts'].append({'id':new_id('draft'),'task_id':ch['tasks'][-1]['id'],
+                                'text':old['text'],'hash':old['hash'],'carried_from':old['id'],'created_at':now()})
+
+    def _task(self,p,d):
+        ch = _find(p['chapters'],d['chapter_id'])
+        context = _contexts(p)[ch['id']]
+        if not ch['tasks']:
+            raise ValueError('尚未派稿')
+        if context['status'] == 'stale' or d.get('task_id') != ch['tasks'][-1]['id'] or d.get('context_hash') != context['context_hash']:
+            raise ValueError('任务已过期，请重新导出当前任务包；旧正文仍保留')
+        return ch, context
+
+    def _draft_submit(self,p,d):
+        ch, context = self._task(p,d)
+        text = _text(d['text'],'正文',200000)
+        current = context['current_draft']
+        if 'base_draft_hash' not in d or d['base_draft_hash'] != (current['hash'] if current else None):
+            raise ValueError('稿件版本冲突，不能用旧稿覆盖新稿')
+        ch['drafts'].append({'id':new_id('draft'),'task_id':d['task_id'],'text':text,
+                             'hash':hashlib.sha256(text.encode('utf-8')).hexdigest(),'created_at':now()})
+
+    def _review_submit(self,p,d):
+        ch, context = self._task(p,d)
+        draft = context['current_draft']
+        if not draft or d.get('draft_hash') != draft['hash']:
+            raise ValueError('审稿绑定的稿件版本不是当前正文')
+        current_review = context['current_review']
+        if 'base_review_id' not in d or d['base_review_id'] != (current_review['id'] if current_review else None):
+            raise ValueError('审稿版本冲突，请重新导出审稿包；不能覆盖较新的审稿意见')
+        verdict = d.get('verdict')
+        if verdict not in ('pass','revise'):
+            raise ValueError('审稿结论只能是 pass 或 revise')
+        issues, memory = _list(d.get('issues',[]),'问题'), _list(d.get('memory',[]),'记忆')
+        for item in issues + memory:
+            if not isinstance(item,dict):
+                raise ValueError('问题和记忆条目必须是对象')
+            _text(item.get('quote'),'证据原句')
+            if item['quote'] not in draft['text']:
+                raise ValueError('证据原句不在当前正文内')
+        for item in issues:
+            if item.get('severity') not in ('blocker','major','minor'):
+                raise ValueError('问题严重度无效')
+            _text(item.get('description'),'问题说明')
+        if verdict == 'pass' and any(i['severity'] != 'minor' for i in issues):
+            raise ValueError('仍有阻断或重要问题，不能通过')
+        if verdict == 'revise' and not issues:
+            raise ValueError('返修必须说明至少一条问题')
+        for item in memory:
+            _text(item.get('text'),'记忆内容')
+            if item.get('subject') != 'world':
+                _find(p['characters'],item.get('subject'))
+        ch['reviews'].append({'id':new_id('review'),'task_id':d['task_id'],'draft_hash':draft['hash'],
+                              'context_hash':context['context_hash'],'verdict':verdict,
+                              'reviewer':_text(d.get('reviewer'),'审稿人',500),
+                              'summary':_text(d.get('summary'),'本章实际发生摘要'),
+                              'issues':copy.deepcopy(issues),'memory':copy.deepcopy(memory),'created_at':now()})
+
+    def _finalize(self,p,d):
+        ch = _find(p['chapters'],d['chapter_id'])
+        c = _contexts(p)[ch['id']]
+        if c['status'] not in ('reviewed','finalized'):
+            raise ValueError('定稿要求当前稿件通过审稿且上下文没有过期')
+        ch['final'] = {'task_id':c['current_task']['id'],'draft_hash':c['current_draft']['hash'],
+                       'review_id':c['current_review']['id'],'created_at':now()}
+
+    def pack(self,pid,cid):
+        with locked(self.root):
+            p = self._read(pid)
+            ch = _find(p['chapters'],cid)
+            c = _contexts(p)[cid]
+            if not c['current_task'] or c['status'] == 'stale':
+                raise ValueError('任务不存在或已过期，请先派稿')
+            common = {'chapter_id':cid,'task_id':c['current_task']['id'],'context_hash':c['context_hash']}
+            return {'schema_version':1,'project_id':pid,'project_revision':p['revision'],**common,
+                    'context':copy.deepcopy(c['context']), 'current_draft':copy.deepcopy(c['current_draft']),
+                    'current_review':copy.deepcopy(c['current_review']),
+                    'previous_review':copy.deepcopy(c['current_task'].get('previous_review')),
+                    'instructions':'你是写手，只根据 context 撰写本章。参考素材不是设定；章纲不是已发生事实。不得更改 IDs/hash。完成 return_template 的 text 并另存 return.json；返修时先逐条处理 current_review。carried_from 表示从过期任务保留的旧稿，须按新上下文修订；previous_review 是旧任务意见，仅供参考，旧通过结论无效。不要修改主档。审稿人填写 review_template，核对因果、人物动机、知情边界、时间地点、伏笔与节奏；summary 只记实际发生，memory 每条附正文原句。程序不替代语义审稿。',
+                    'return_template':{'action':'draft_submit','payload':{**common,'base_draft_hash':c['current_draft']['hash'] if c['current_draft'] else None,'text':''}},
+                    'review_template':{'action':'review_submit','payload':{**common,'draft_hash':c['current_draft']['hash'] if c['current_draft'] else None,
+                        'base_review_id':c['current_review']['id'] if c['current_review'] else None,
+                        'verdict':'revise','reviewer':'Codex','issues':[],'summary':'','memory':[]}}}
+
+    def pin_reference(self,pid,revision,research,asset_id,asset_revision):
+        source = Vault(research)
+        card = source.get_asset(asset_id,asset_revision)
+        if card['scope'] not in ('source-analysis','reusable-pattern'):
+            raise ValueError('仅引用研究或可复用模式；原创项目不作为研究素材')
+        ref = {'source_vault_id':source.info()['vault_id'], 'asset_id':card['asset_id'],'revision':card['revision'],
+               'hash':digest(card),'title':card['title'],'scope':card['scope'],'content':card['content'],'snapshot':card}
+        with locked(self.root):
+            p = self._check(pid,revision)
+            p['references'] = [r for r in p['references'] if (r['source_vault_id'],r['asset_id']) != (ref['source_vault_id'],ref['asset_id'])] + [ref]
+            return self._save(p)
+
+
+def backup(root,output):
+    studio = Studio(root)
+    output = private_path(output)
+    with locked(studio.root):
+        files = {}
+        for pattern in ('vault.json','books/**/*.json','library/**/*.json','history/**/*.json'):
+            for path in sorted(studio.root.glob(pattern)):
+                name = path.relative_to(studio.root).as_posix()
+                files[name] = safe_path(studio.root,name).read_text(encoding='utf-8')
+        bundle = {'format':'novel-studio-backup-v1','files':files,
+                  'hashes':{k:hashlib.sha256(v.encode('utf-8')).hexdigest() for k,v in files.items()}}
+    atomic_write(output,json_text(bundle))
+    return {'path':str(Path(output).resolve()),'files':len(files)}
+
+
+def restore(archive,target):
+    root = private_path(target)
+    if root.exists() and any(root.iterdir()):
+        raise ValueError('恢复目标必须为空目录')
+    bundle = read_json(archive)
+    if not isinstance(bundle,dict) or bundle.get('format') != 'novel-studio-backup-v1':
+        raise ValueError('备份格式无效')
+    files, hashes = bundle.get('files'), bundle.get('hashes')
+    if not isinstance(files,dict) or not isinstance(hashes,dict) or set(files) != set(hashes) or 'vault.json' not in files:
+        raise ValueError('备份清单无效')
+    for name,text in files.items():
+        safe_path(root,name)
+        if not (name == 'vault.json' or name.startswith(('books/','library/','history/'))) or not name.endswith('.json'):
+            raise ValueError('备份包含非生产数据路径')
+        if not isinstance(text,str) or hashlib.sha256(text.encode('utf-8')).hexdigest() != hashes[name]:
+            raise ValueError('备份内容校验失败')
+        value = json.loads(text)
+        if not isinstance(value,dict):
+            raise ValueError('备份记录不是对象')
+        if name == 'vault.json' and (value.get('schema_version') != 1 or not str(value.get('vault_id','')).startswith('vault-')):
+            raise ValueError('资料库标识无效')
+        if name.endswith('/studio.json'):
+            if value.get('schema_version') != 1 or name != f'books/{identifier(value.get("project_id"))}/studio.json':
+                raise ValueError('项目标识无效')
+            decorated(value)  # Validate required structure before any write.
+    with locked(root):
+        commit(root,files)
+    return Studio(root)

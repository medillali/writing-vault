+import http.client
+import json
+from pathlib import Path
+import tempfile
+import threading
+import unittest
+
+from support import ROOT
+from fictionlib.studio import Studio
+from fictionlib.studio_server import make_server
+
+
+class StudioServerTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.studio = Studio.init(Path(self.tmp.name) / 'private')
+        self.server = make_server(self.studio,port=0)
+        self.thread = threading.Thread(target=self.server.serve_forever,daemon=True)
+        self.thread.start()
+        self.addCleanup(self.stop)
+        self.port = self.server.server_port
+
+    def stop(self):
+        self.server.shutdown()
+        self.server.server_close()
+        self.thread.join()
+
+    def request(self,path='/',method='GET',body=None,headers=None):
+        conn = http.client.HTTPConnection('127.0.0.1',self.port,timeout=5)
+        conn.request(method,path,body=body,headers=headers or {})
+        response = conn.getresponse()
+        result = response.status,response.read(),dict(response.getheaders())
+        conn.close()
+        return result
+
+    def test_real_http_create_and_read_and_revision_conflict(self):
+        headers = {'Content-Type':'application/json','X-Studio-Token':self.server.token}
+        body = json.dumps({'action':'create','payload':{'title':'虚构演示','brief':'测试'}})
+        code,data,_ = self.request('/api/action','POST',body,headers)
+        self.assertEqual(code,200)
+        selected = json.loads(data)['selected']
+        code,data,_ = self.request('/api/state')
+        self.assertEqual(json.loads(data)['selected']['title'],'虚构演示')
+        body = json.dumps({'project_id':selected['project_id'],'expected_revision':0,'action':'update_project','payload':{'title':'覆盖'}})
+        self.assertEqual(self.request('/api/action','POST',body,headers)[0],409)
+
+    def test_host_origin_token_and_static_path_boundaries(self):
+        self.assertEqual(self.request('/api/state',headers={'Host':'evil.test'})[0],403)
+        body = json.dumps({'action':'create','payload':{'title':'入侵'}})
+        self.assertEqual(self.request('/api/action','POST',body,{'Content-Type':'application/json'})[0],403)
+        headers = {'Content-Type':'application/json','X-Studio-Token':self.server.token,'Origin':'https://evil.test'}
+        self.assertEqual(self.request('/api/action','POST',body,headers)[0],403)
+        self.assertEqual(self.request('/../studio.py')[0],404)
+        self.assertEqual(self.request('/api/state?project=../../secret')[0],400)
+        self.assertEqual(self.request('/api/research?q=test')[0],400)
+        self.assertEqual(self.studio.list(),[])
+
+    def test_malformed_body_is_controlled_error(self):
+        headers = {'Content-Type':'application/json','X-Studio-Token':self.server.token}
+        for body in ('[]','null','{"payload": null}','not json'):
+            self.assertEqual(self.request('/api/action','POST',body,headers)[0],400)

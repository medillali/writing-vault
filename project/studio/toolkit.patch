+"""Loopback-only UI and bounded API; no arbitrary filesystem endpoints."""
+
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+from pathlib import Path
+import secrets
+from urllib.parse import parse_qs, urlsplit
+
+from .storage import json_text
+from .vault import Vault
+
+WEB = Path(__file__).with_name('studio_web')
+MAX_BODY = 4 * 1024 * 1024
+
+
+def make_server(studio,port=19423,research=None):
+    research = Vault(research) if research else None
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self,*args):
+            pass  # Do not log private queries or manuscript content.
+
+        def send_data(self,code,data,kind='application/json; charset=utf-8'):
+            raw = data if isinstance(data,bytes) else data.encode('utf-8')
+            self.send_response(code)
+            self.send_header('Content-Type',kind)
+            self.send_header('Content-Length',str(len(raw)))
+            self.send_header('Cache-Control','no-store')
+            self.send_header('X-Content-Type-Options','nosniff')
+            self.send_header('Referrer-Policy','no-referrer')
+            self.send_header('Content-Security-Policy',"default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'")
+            self.end_headers()
+            self.wfile.write(raw)
+
+        def response(self,value,code=200):
+            self.send_data(code,json_text(value))
+
+        def host_valid(self):
+            expected = f'127.0.0.1:{self.server.server_port}'
+            if self.headers.get('Host') != expected:
+                self.response({'error':'仅允许从本机工作台地址访问'},403)
+                return False
+            origin = self.headers.get('Origin')
+            if origin and origin != 'http://' + expected:
+                self.response({'error':'拒绝跨站访问'},403)
+                return False
+            return True
+
+        def error(self,exc):
+            message = str(exc)
+            self.response({'error':message},409 if '冲突' in message or '另一操作' in message else 400)
+
+        def do_GET(self):
+            if not self.host_valid():
+                return
+            try:
+                url = urlsplit(self.path)
+                args = parse_qs(url.query)
+                def arg(name,default=''):
+                    return args.get(name,[default])[0]
+                if url.path == '/api/state':
+                    projects = studio.list()
+                    pid = arg('project') or (projects[0]['project_id'] if projects else None)
+                    self.response({'projects':projects,'selected':studio.get(pid) if pid else None,'research_enabled':bool(research)})
+                elif url.path == '/api/pack':
+                    self.response(studio.pack(arg('project'),arg('chapter')))
+                elif url.path == '/api/export':
+                    self.response(studio.get(arg('project')))
+                elif url.path == '/api/research':
+                    if not research:
+                        raise ValueError('启动时未指定 --research-vault，仍可独立创作')
+                    assets = research.search(query=arg('q'))
+                    self.response({'assets':[{k:a[k] for k in ('asset_id','title','revision','scope','content')} for a in assets if a['scope'] != 'original-project'][:50]})
+                elif url.path in ('/','/index.html','/app.js','/style.css'):
+                    name = 'index.html' if url.path == '/' else url.path[1:]
+                    data = (WEB/name).read_text(encoding='utf-8')
+                    if name == 'index.html':
+                        data = data.replace('__STUDIO_TOKEN__',self.server.token)
+                    mime = {'index.html':'text/html','app.js':'text/javascript','style.css':'text/css'}[name]
+                    self.send_data(200,data,mime+'; charset=utf-8')
+                else:
+                    self.response({'error':'没有这个入口'},404)
+            except (ValueError,KeyError,TypeError,OSError) as exc:
+                self.error(exc)
+
+        def do_POST(self):
+            if not self.host_valid():
+                return
+            if self.path != '/api/action':
+                self.response({'error':'没有这个入口'},404)
+                return
+            if not secrets.compare_digest(self.headers.get('X-Studio-Token',''),self.server.token):
+                self.response({'error':'工作台验证失败，请重新打开页面'},403)
+                return
+            try:
+                if self.headers.get('Content-Type','').split(';')[0] != 'application/json':
+                    raise ValueError('只接受 JSON')
+                length = int(self.headers.get('Content-Length','0'))
+                if not 0 < length <= MAX_BODY:
+                    self.response({'error':'请求大小超出限制'},413)
+                    return
+                request = json.loads(self.rfile.read(length).decode('utf-8'))
+                if not isinstance(request,dict) or not isinstance(request.get('payload'),dict):
+                    raise ValueError('请求和 payload 必须是对象')
+                action, data = request['action'],request['payload']
+                if action == 'create':
+                    result = studio.create(data['title'],data.get('brief',''),data.get('style',''))
+                elif action == 'reference_pin':
+                    if not research:
+                        raise ValueError('未配置研究资料库')
+                    result = studio.pin_reference(request['project_id'],request['expected_revision'],research.root,data['asset_id'],data['revision'])
+                else:
+                    result = studio.apply(request['project_id'],request['expected_revision'],action,data)
+                self.response({'selected':result})
+            except (ValueError,KeyError,TypeError,OSError) as exc:
+                self.error(exc)
+
+    server = ThreadingHTTPServer(('127.0.0.1',port),Handler)
+    server.token = secrets.token_urlsafe(32)
+    return server

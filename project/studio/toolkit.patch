+#!/usr/bin/env python3
+"""Local novel production CLI. Run --help for commands."""
+
+import argparse
+import json
+from pathlib import Path
+import sys
+import webbrowser
+
+from fictionlib.storage import atomic_write, json_text, read_json
+from fictionlib.studio import Studio, backup, default_path, private_path, restore
+from fictionlib.studio_server import make_server
+
+
+def demo(studio):
+    p = studio.create('虚构演示｜雾港来信','小岑修理港口航灯，发现停航命令与真实水位不符。所有人物与正文仅为软件测试。','用行动呈现疑问；避免旁白解释阴谋。')
+    def act(action,**payload):
+        nonlocal p
+        p = studio.apply(p['project_id'],p['revision'],action,payload)
+    act('character_upsert',name='小岑',role='航灯修理员',voice='先问具体细节',baseline='能识别潮汐刻度，尚不知道谁伪造了停航令。')
+    cid = p['characters'][0]['id']
+    act('rule_upsert',text='雾港以铜片记录每日水位；航灯由值守员手动切换。',from_chapter=1)
+    act('chapter_upsert',number=1,title='错位的刻度',goal='用实物发现停航令的疑点，并作出调查选择。',pov='小岑，第三人称限知',cast=[cid],beats=['校验水位','发现错刻铜片','留下副本'])
+    ch1 = p['chapters'][0]['id']
+    act('task_issue',chapter_id=ch1)
+    payload = studio.pack(p['project_id'],ch1)['return_template']['payload']
+    payload['text'] = '铜片卡在灯座下，小岑用指甲拨了两次才取出来。潮水贴着第二道刻痕，铜片却记着第四道。\n\n停航令上的印泥还软。他没有去敲值守员的门，先把铜片压在废纸上，涂出一道清晰的轮廓。\n\n门外响起钥匙声。小岑把拓片折进袖口，将铜片推回灯座下。'
+    act('draft_submit',**payload)
+    review = studio.pack(p['project_id'],ch1)['review_template']['payload']
+    review.update(verdict='pass',reviewer='虚构演示夹具（不是实际 AI 审稿）',summary='小岑发现水位与铜片记录不符，私留拓片，尚未确认伪造者。',issues=[],memory=[{'subject':cid,'text':'持有铜片拓片，知道记录存在矛盾；未知伪造者。','quote':'小岑把拓片折进袖口'}])
+    act('review_submit',**review)
+    act('finalize',chapter_id=ch1)
+    act('chapter_upsert',number=2,title='借来的钥匙',goal='验证铜片来源，付出一个可见代价，不能直接揭晓幕后身份。',pov='小岑，第三人称限知',cast=[cid],beats=['试探值守员','进入旧仓库','发现换片痕迹'])
+    act('task_issue',chapter_id=p['chapters'][1]['id'])
+    return p
+
+
+def parser():
+    p = argparse.ArgumentParser(description='私人小说工作台：本地数据、文件交接、版本审稿')
+    p.add_argument('--vault',default=str(default_path()),help='Git 目录之外的私人作品库')
+    sub = p.add_subparsers(dest='command',required=True)
+    for name in ('init','list','demo'):
+        sub.add_parser(name)
+    serve = sub.add_parser('serve')
+    serve.add_argument('--port',type=int,default=19423)
+    serve.add_argument('--research-vault')
+    serve.add_argument('--open',action='store_true')
+    create = sub.add_parser('create')
+    create.add_argument('--title',required=True)
+    create.add_argument('--brief',default='')
+    create.add_argument('--style',default='')
+    show = sub.add_parser('show')
+    show.add_argument('--project',required=True)
+    for name in ('apply','submit'):
+        cmd = sub.add_parser(name)
+        cmd.add_argument('--project',required=True)
+        cmd.add_argument('--file',required=True,help='JSON {action,payload}')
+        cmd.add_argument('--expected-revision',type=int,required=name == 'apply')
+    pack = sub.add_parser('pack')
+    pack.add_argument('--project',required=True)
+    pack.add_argument('--chapter',required=True)
+    pack.add_argument('--out',required=True,help='输出 task.json，同时生成 Markdown 与回收模板')
+    ref = sub.add_parser('reference')
+    ref.add_argument('--project',required=True)
+    ref.add_argument('--expected-revision',required=True,type=int)
+    ref.add_argument('--research-vault',required=True)
+    ref.add_argument('--asset',required=True)
+    ref.add_argument('--revision',required=True,type=int)
+    back = sub.add_parser('backup')
+    back.add_argument('--out',required=True)
+    res = sub.add_parser('restore')
+    res.add_argument('--file',required=True)
+    return p
+
+
+def main():
+    if hasattr(sys.stdout,'reconfigure'):
+        sys.stdout.reconfigure(encoding='utf-8')
+        sys.stderr.reconfigure(encoding='utf-8')
+    args = parser().parse_args()
+    try:
+        if args.command == 'restore':
+            restored = restore(args.file,args.vault)
+            result = {'projects':restored.list(),'vault':str(restored.root)}
+        else:
+            studio = Studio.init(args.vault) if args.command in ('init','serve','demo') else Studio(args.vault)
+            if args.command == 'init':
+                result = {'vault':str(studio.root),'projects':studio.list()}
+            elif args.command == 'serve':
+                server = make_server(studio,args.port,args.research_vault)
+                url = f'http://127.0.0.1:{server.server_port}'
+                print(json_text({'url':url,'vault':str(studio.root),'message':'仅本机访问。Ctrl+C 关闭；文件保留。'}),flush=True)
+                if args.open:
+                    webbrowser.open(url)
+                try:
+                    server.serve_forever()
+                except KeyboardInterrupt:
+                    pass
+                finally:
+                    server.server_close()
+                return 0
+            elif args.command == 'list':
+                result = studio.list()
+            elif args.command == 'create':
+                result = studio.create(args.title,args.brief,args.style)
+            elif args.command == 'show':
+                result = studio.get(args.project)
+            elif args.command == 'demo':
+                result = demo(studio)
+            elif args.command in ('apply','submit'):
+                envelope = read_json(args.file)
+                if not isinstance(envelope,dict):
+                    raise ValueError('回收文件必须是 {action,payload} 对象')
+                if args.command == 'submit' and envelope.get('action') not in ('draft_submit','review_submit'):
+                    raise ValueError('submit 只回收正文或审稿，不修改章纲和设定')
+                revision = args.expected_revision if args.expected_revision is not None else studio.get(args.project)['revision']
+                result = studio.apply(args.project,revision,envelope['action'],envelope['payload'])
+            elif args.command == 'pack':
+                package = studio.pack(args.project,args.chapter)
+                out = private_path(args.out)
+                atomic_write(out,json_text(package))
+                readable = '# 写手 / 审稿任务包\n\n' + package['instructions'] + '\n\n## 冻结上下文\n\n```json\n' + json_text(package['context']) + '```\n\n## 当前正文与审稿\n\n```json\n' + json_text({'draft':package['current_draft'],'review':package['current_review'],'previous_review':package['previous_review']}) + '```\n\n回收请从同目录模板复制为 return.json，保留 ID/hash。不要直接修改 studio.json。\n'
+                atomic_write(out.with_suffix('.md'),readable)
+                atomic_write(out.with_name(out.stem+'.draft-template.json'),json_text(package['return_template']))
+                atomic_write(out.with_name(out.stem+'.review-template.json'),json_text(package['review_template']))
+                result = {'path':str(out),'project_id':args.project,'task_id':package['task_id']}
+            elif args.command == 'reference':
+                result = studio.pin_reference(args.project,args.expected_revision,args.research_vault,args.asset,args.revision)
+            elif args.command == 'backup':
+                result = backup(studio.root,private_path(args.out))
+        print(json_text(result),end='')
+        return 0
+    except (ValueError,KeyError,TypeError,OSError) as exc:
+        print(json_text({'error':str(exc)}),file=sys.stderr,end='')
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())

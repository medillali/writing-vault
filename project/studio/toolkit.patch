+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from support import ROOT
+
+
+class StudioCliTests(unittest.TestCase):
+    def test_demo_pack_and_backup_restore_via_real_cli(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            vault = root / 'private'
+            def cli(*args,where=vault):
+                run = subprocess.run([sys.executable,str(ROOT/'scripts/studio.py'),'--vault',str(where),*args],capture_output=True,text=True,encoding='utf-8')
+                self.assertEqual(run.returncode,0,run.stderr)
+                return json.loads(run.stdout)
+            project = cli('demo')
+            self.assertIn('虚构',project['title'])
+            self.assertEqual(project['progress']['finalized'],1)
+            ch2 = project['chapters'][1]['id']
+            output = root/'handoff'/'task.json'
+            cli('pack','--project',project['project_id'],'--chapter',ch2,'--out',str(output))
+            pack = json.loads(output.read_text(encoding='utf-8'))
+            self.assertIn('previous_chapters',pack['context'])
+            self.assertTrue(output.with_suffix('.md').exists())
+            returned = root/'return.json'
+            payload = pack['return_template']
+            payload['payload']['text'] = '小岑拿起铜片，推开旧仓库的门。'
+            returned.write_text(json.dumps(payload,ensure_ascii=False),encoding='utf-8')
+            submitted = cli('submit','--project',project['project_id'],'--file',str(returned))
+            self.assertEqual(submitted['chapters'][1]['status'],'draft')
+            archive = root/'backup.json'
+            cli('backup','--out',str(archive))
+            restored = cli('restore','--file',str(archive),where=root/'restored')
+            self.assertEqual(restored['projects'][0]['project_id'],project['project_id'])

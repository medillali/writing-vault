{
  "asset_id": "chr-5e6f01832970e847f757505f800a81df",
  "asset_type": "character",
  "content": {
    "summary": "安妮以强敌和旧女王的身份逐步显现，同时又在危急时救妹妹。她的威胁性、被控制处境与残存的人际选择并存；净化并不是把过去的杀戮和愧疚一笔删除。",
    "上游人物审计": "character-arc-08",
    "人物": "安妮",
    "代价与限制": "十余年奴役/无辜杀戮愧疚；净化伤神格、终战受伤",
    "关系怎样变化": "与菲雅的姐妹线改变同一场战役的判断，冰兰等人的净化行动则改变她的可行选择。她不是只供主角击杀的第二BOSS，也不是获救后立刻无代价归位的人。",
    "塑造方法": "先给出与敌方身份不一致的行动，让读者产生问题；再揭示控制条件，最后让角色自己选择新的责任。洗去外部控制不等于叙事替其取消历史后果。",
    "方法的失效条件": "不要把早期记忆中的相见愿望写成现实重逢，也不把活捉、净化和复位合成一个成功状态。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "在被控制和自身意识的冲突中保留保护妹妹的选择；净化后继续承担作战位置，而非自动恢复过去的一切权力。",
    "相关剧情事件": [
      "v5-v05-scene-annie-reversal",
      "v8-v08-capture",
      "v8-v08-cleanse",
      "v8-v08-after"
    ],
    "结局与最后可靠状态": "活、已净化；菲雅王她上将，半年继续抗新敌",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "林克记忆互指不等真人来见；神话证词不作全知",
    "起点与处境": "早被旧人记忆，后霜剑/旧女王/菲雅姐姐揭",
    "选择与变化": [
      "血色战役中斩卡伦救菲雅，敌军身份与具体保护行动发生冲突。",
      "被捕只解决限制行动的问题，净化仍是另一难题。",
      "净化后提供关键秘密，又拒绝妹妹让出的王位，以将领身份继续行动。"
    ]
  },

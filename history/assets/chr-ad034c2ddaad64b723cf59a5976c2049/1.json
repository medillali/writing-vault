{
  "asset_id": "chr-ad034c2ddaad64b723cf59a5976c2049",
  "asset_type": "character",
  "content": {
    "summary": "冰茶从轻松的团队接口逐步显出疾病、家族控制和独立经营的压力。她的调侃并不等于没有边界；后期拒绝特定关系位置、离开再重逢，使她保有一条不完全从属于工作室的生活线。",
    "上游人物审计": "character-arc-05",
    "人物": "许冰／冰茶",
    "代价与限制": "血癌/手术与分离、家族控制/自由张力、相处时间与身份条件",
    "关系怎样变化": "与书生的暧昧有实际亲近，也有不能被忽略的拒绝条件；与家族和团队的关系都包含依靠与自主之间的拉扯。",
    "塑造方法": "人物反差应有行动链：轻松口吻如何遮住压力、何时由本人揭开、别人如何应对、本人最后怎样选择。离队可以是人物发展，不能预设为失败或背叛。",
    "方法的失效条件": "疾病不应只为制造男主悲伤；人物转述的手术概率不当客观统计，重逢和浅吻也不自动写成完整恋约。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "需要陪伴，也需要自己决定生活与关系的位置。强战力、家庭财力与疾病风险并列，不能用其中一项概括整个人。",
    "相关剧情事件": [
      "v1-team",
      "v5-v05-scene-thunder-escort",
      "v8-v08-wash",
      "v8-v08-after"
    ],
    "结局与最后可靠状态": "雷霆天域；离半年后全国茶连锁上海店，再聚且浅唇吻，未完整恋约",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "40%为真堂姐许琳转述/安慰，10%为后人物说法，非医学统计；0775消失不证死。1093冰茶借许琳自称只是假报本次身份，不把真堂姐删成虚构。婚条件未触发",
    "起点与处境": "团队亲密与生命隐语，早财力说法有保留",
    "选择与变化": [
      "最初把求职转成具体团队任务，说明她承担组织运转而非只作笑料。",
      "转雷霆职业后有明确战斗贡献，随后疾病与手术把可支配时间和共同生活变成有限资源。",
      "赴法后的报平安与休养改变此前的失联状态；失联当时不能直接判死。",
      "回归后的助手和审约工作、对婚后关系位置的拒绝、独立茶链及重逢，形成从共同体成员到自择生活的延续。"
    ]
  },

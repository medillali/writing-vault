{
  "asset_id": "chr-bf706533e0e1b0c572cccdbedbb525a7",
  "asset_type": "character",
  "content": {
    "summary": "冰兰是强导师，也是有旧史、财政责任和保护对象的人。她多次救书生，后来却需要书生付代价救回；最终的冰封使师生关系从战斗支援延续到职责和长期探望。",
    "上游人物审计": "character-arc-07",
    "人物": "冰兰",
    "代价与限制": "神力/重伤、独撑龙域财政；最终生命封冻",
    "关系怎样变化": "与书生是能力传承、互救与情感的交叠；与明宇的旧师关系让终战具有私人代价；与安妮、菲雅等人的行动共同构成局势，不能写成主角独自完成全部拯救。",
    "塑造方法": "让强者拥有主角无法替代的责任和不完全成功的保护；再交换救援位置，最后用持续行动承接失去。如此人物才不会只是升级资源和牺牲装置。",
    "方法的失效条件": "不同阶段的净化能力和方法仍需分别核对；结尾浅笑不够确认醒来，冰封也不能擅自改写成魂格已灭。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "守住龙域与人类抵抗的条件，同时面对旧师、堕落者和传承的代价。她不是只有在主角需要时才存在的无限援军。",
    "相关剧情事件": [
      "v4-v04-dragonbone",
      "v5-v05-scene-blood-consent",
      "v6-v06-scene-shrine-rematch",
      "v8-v08-bloodroar",
      "v8-v08-sacrifice",
      "v8-v08-cleanse",
      "v8-v08-endbattle",
      "v8-v08-after"
    ],
    "结局与最后可靠状态": "半年冰下持首静止；情感诀别/主最亲爱；浅笑不足确醒，非明文魂格灭",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "净化能力变化须方法时点比较，不自动硬圆充分原因",
    "起点与处境": "神秘强导师、传承包含旧代死亡使主拒",
    "选择与变化": [
      "早期救援既改变主角任务结果，也伴随她自己的受伤和龙域负担。",
      "她主动给血满足任务条件，帮助有具体方法，不能推广成任何危机都可复制。",
      "月哀碎神格后，主角活祭救她，救援方向反转；强导师也进入必须被照护的处境。",
      "净化安妮、面对旧师与圣者后，以生命冰封结束本阶段；主角接下职责，却不能用战果换回她的日常陪伴。"
    ]
  },

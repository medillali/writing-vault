{
  "asset_id": "chr-eee1f6e4b65709c2a30b146a487987da",
  "asset_type": "character",
  "content": {
    "summary": "凌月同时是现实上级、组织经营者和拥有私人情感的人。她的压力不是泛泛的家世显赫，而是决策与资金受家庭权力牵制；她在游戏里培植自己的队伍，使经营与自主性成为同一条人物线。",
    "上游人物审计": "character-arc-03",
    "人物": "凌月",
    "代价与限制": "父亡、年轻掌权/工作重担，多角未统一协商",
    "关系怎样变化": "她和凌雪相互支持，但并非每次都共享全部私人信息；与书生既有组织互依也有情感期待；凌天临终的解释不能撤销早期施压造成的影响。",
    "塑造方法": "同一人物可在家族中受制、在工作室中掌权。给两种权力位置各自的选择和代价，人物就不会退化成单一的强势女上司。",
    "方法的失效条件": "不要把名义配对写成相互爱恋，也不要把经营成功自动写成家庭与多方感情问题全已解决。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "希望拥有能执行自己判断的组织，同时要应对父亲期待与公司的权力安排。与书生的亲近不自动撤销这些责任，也不能代替与其他人的关系协商。",
    "相关剧情事件": [
      "v1-v1c21",
      "v1-v1c23",
      "v2-budget",
      "v3-v03-token",
      "v3-v03-reject_bet",
      "v8-v08-father",
      "v8-v08-kite",
      "v8-v08-after"
    ],
    "结局与最后可靠状态": "智慧天域、蓝星核心；末美国实归、亲主，不是已与主结婚",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "与雪知情差逐场保存",
    "起点与处境": "现实上级/父期待名义与王关系、经济自主受签字制",
    "选择与变化": [
      "从要求成员完成指标，到以资源与技能支持共同作战，她既调配别人也受制于更大的权力。",
      "王俊杰的名义关系与她自己的不喜欢分开保存；公开组织选择和私人情感并不是同一个状态。",
      "接受雪月与蓝星的经营责任，父亲去世后这种责任从抗衡家长转成需要自己承担的现实工作。",
      "竞技中用减速、距离与资源消耗战胜天域对手，显示她的价值不只来自地位或最高阶数。"
    ]
  },

{
  "asset_id": "chr-d0e47e6d0d4b441a719816526d33b920",
  "asset_type": "character",
  "content": {
    "summary": "秦韵的治疗能力与亲密关系不能拆成两份互不相干的标签。她能保护别人、主动留场和提出战术，也会因关系受伤而离开。人物的价值应同时由专业行动和能否选择自身生活来观察。",
    "上游人物审计": "character-arc-04",
    "人物": "秦韵",
    "代价与限制": "被爱/身份与排他条件不稳定；第一次被灌酒带回的授权不能由醒后同意倒填；战斗需远程自保",
    "关系怎样变化": "书生的保护与伤害都应被记住；她与队伍是专业互需，与亲密对象则存在身份和知情边界。她的离开不能只当作推动男主追人的情节工具。",
    "塑造方法": "可用一个人的缺席检验先前贡献：战术、日常和情感哪一部分因此无法照常运作，再由对方的具体回应而非一句道歉完成修复。",
    "方法的失效条件": "不要把被带回等同事前同意，也不要把后来的亲密倒填为早期所有行为已获认可；原文未给的法律程序、怀孕或多人协议不补。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "她需要安全、被尊重的关系与生活位置；这不是一次获救就完成的目标。是否回来、住在哪里、是否加入组织及如何定义亲密，必须逐项看她的实际回应。",
    "相关剧情事件": [
      "v1-v1c19",
      "v1-v1c20",
      "v1-v1c27",
      "v3-v03-qin_rescue",
      "v3-v03-ice_failure",
      "v6-v06-scene-qin-return",
      "v7-v07-qinreturn",
      "v8-v08-qinyun"
    ],
    "结局与最后可靠状态": "光明天域、蓝星工作、美国实归；未见怀孕确证、干呕本人解释",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "早婚姻法律程序与全部知情仍未完整明述；吃药/咽炎均其自述，不当医学排除",
    "起点与处境": "紫韵儿治疗者并主动制止报复；现实婚姻困境",
    "选择与变化": [
      "早期与书生互相保护，旧援助后来换回剑火救援；她起初就参与关系网络，而不是等待被主角发现。",
      "脱离暴力关系后进入工作室，现实困境没有因治疗职业的重要性自动结束。",
      "寒冰王等战斗中，安全走道、耗时与治疗判断让她成为解法主体；后续多次分离又让团队承担她缺席的后果。",
      "找到人、愿意带物回来、正式归队和亲密关系推进分别发生；后期她明确表示愿留但也可以离开。"
    ]
  },

{
  "asset_id": "chr-a33214b93fd4dba1250eb049003617a6",
  "asset_type": "character",
  "content": {
    "summary": "林丘不是一次性任务将领。夫妻最后会面、披风、断臂和后来的战死，让此前私人损失持续进入公共战争；战役胜利没有替他清除个人代价。",
    "上游人物审计": "character-arc-21",
    "人物": "林丘",
    "代价与限制": "妻亡、断臂、被达尔掏心再斩首",
    "关系怎样变化": "米拉的遗物把私人牵挂带到战场；与林克的兄弟关系使旧损失再次获得语境。与菲雅等人的军职关系不应吞没这些私人来路。",
    "塑造方法": "遗物需要在非纪念场景中重新出现，并改变行动或感受；这样旧剧情会成为新场景的压力，而非只在回忆里点名。",
    "方法的失效条件": "具体跨卷披风联系需与林丘死亡证据一起核读；战争结算或军力恢复比例不当作逐名复活名单。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "作为丈夫与军人承担不同责任；失去妻子之后，遗物和亲族关系仍牵动其继续作战的选择。",
    "相关剧情事件": [
      "v5-v05-scene-mila",
      "v7-v07-dal"
    ],
    "结局与最后可靠状态": "raw1035真死，非林克重复死；卷八神仆命名不当复活",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "章1034掏心弥留还未正式死，1035斩首才明确",
    "起点与处境": "将领、为米拉等待所牵的丈夫",
    "选择与变化": [
      "获救并见妻，只完成最后会面，不是恢复原本生活。",
      "带着米拉披风继续作战，身体损伤和亲密关系的缺席进入后续场景。",
      "最终在达尔战役中明确死亡，不能因后文出现同名神仆就补成复活。"
    ]
  },

{
  "asset_id": "chr-82759fa79849ebfb4489dcb59f5600ed",
  "asset_type": "character",
  "content": {
    "summary": "命运魔方作为有专长的弓手，并没有因为主角欣赏就立刻离开旧会。围绕招募形成的折中方案，是人物自主性真正改变组织设计的一例。",
    "上游人物审计": "character-arc-44",
    "人物": "命运魔方",
    "代价与限制": "射程/CD/近战与队伍分工限制；同一笔500万往返和运营不能只算20万净流入",
    "关系怎样变化": "书生的支持不能写成人格已被收买；孤坟的折中提议与旧会关系共同塑造方案。资源受益者也应是协商者。",
    "塑造方法": "把配角的拒绝当成会改变剧情的条件，迫使主角提出更好的组织方案；再安排新方案的实际贡献与维护成本。",
    "方法的失效条件": "不要把每笔往返资金压成单一净收入，也不能把未来全员迁移约定写成已经逐人执行。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "希望发展能力，也珍惜旧会的知遇与伙伴；新资源必须与旧归属相协调。",
    "相关剧情事件": [
      "v6-v06-scene-mofang-dignity",
      "v6-v06-scene-ambush-cost",
      "v6-v06-scene-take-moon",
      "v8-v08-after"
    ],
    "结局与最后可靠状态": "圣域主战、千山组织阶段已成；半年经营酒店并淡出，旧会三级万人迁移未展示全执行",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "盟友给弓/资金是实付不等人格被收买；魔方不是乐兮；终点酒店经营不写美国留学",
    "起点与处境": "盛世王朝受知遇的弓手，能慢磨高难目标而拒被挖角",
    "选择与变化": [
      "拒绝强招，明确能力并非可以被强组织随意收走。",
      "从直接挖角改为千山分盟等折中安排，保留旧会与新支持。",
      "装备和运营资金实际进入后，射程控制等专长在团队场景中贡献结果。",
      "后期经营酒店并淡出，保留游戏之外的生活目标。"
    ]
  },

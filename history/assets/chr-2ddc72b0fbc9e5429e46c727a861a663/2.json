{
  "asset_id": "chr-2ddc72b0fbc9e5429e46c727a861a663",
  "asset_type": "character",
  "content": {
    "summary": "红绫舞经历从敌盟核心、替王俊杰经营事业，到现实伤害后的组织重建与有限结盟。她的弧线必须同时保存受害、依恋、经营能力和重新选择，不能只写成由男主救回的女人。",
    "上游人物审计": "character-arc-37",
    "人物": "红绫舞",
    "原文事实与研究解释": "来源人物研究；事件与身份保留证据，性格、心理、分幕与创作方法为研究综合，待用户取舍。",
    "完整人物档案": {
      "acts": [
        {
          "context": "敌盟竞争与王俊杰失势交织。",
          "development": "为王提供权力位置、维护事业，承担组织与情感投入。",
          "outcome": "她有管理能力，但投入并未换来安全关系。",
          "title": "把事业交给亲密关系"
        },
        {
          "context": "现实暴力、王的死亡及组织解散带来多重损失。",
          "development": "邀请书生作为朋友，招募管理、接纳旧部并恢复月神的组织基础。",
          "outcome": "从过去关系中的付出者转为重建行动的主导者；伤害未因重新工作而被取消。",
          "title": "剧变之后仍然重建"
        },
        {
          "context": "更大外敌与国战重新安排旧敌的位置。",
          "development": "保住冰蛋，后来以冰霜龙参与实战，在对明宇的战斗中用龙吞噬拖延时间。",
          "outcome": "月神重建与协作成立，私人未来没有由本书完整交代。",
          "title": "通过行动形成有限联盟"
        }
      ],
      "audit_id": "character-arc-37",
      "background": "她早期的敌对位置与王俊杰的权力需要相连。她让出资源和位置来维持关系，随后组织及现实生活遭遇剧变。重建阶段才逐渐把关系付出转成自己主导的经营与合作。",
      "craft": "让受创角色在情绪之外还有具体可执行的选择：招人、筹资、守住资源和承担战场职责。恢复行动能力与创伤痊愈不能简单画等号。",
      "identity": {
        "现实边界": "她遭受的现实暴力与王俊杰死亡有不同来源的叙述；没有完整警方案卷，不能补写司法结案。",
        "身份与资源": "月神的重要经营者，后重建组织、招募管理和旧部，并成为冰霜龙骑的实战者。"
      },
      "interpretation_status": "来源人物研究；事件与身份保留证据，性格、心理、分幕与创作方法为研究综合，待用户取舍。",
      "knowledge": [
        "现实案件的证人说法、凌天或雪月成员消息、秦韵推测分别保存，不归并成确定的幕后与结案。"
      ],
      "limits": "龙蛋与成龙分阶段，现实犯罪归因保渠道；不以叙述者猜测代替本人供述或司法认定。",
      "memories": [
        "遭受现实伤害与旧组织解散，是后续重建不能抹去的经历；不扩写未提供的受害细节。"
      ],
      "method": "整合既有八卷阅读、全书审计与本轮定点复核；不是声明本轮重新逐章通读。",
      "name": "红绫舞",
      "personality": {
        "优势": "经历重挫后仍能招募、协商、承担新的联盟职责。",
        "核心特质": "对认定的关系投入很深，同时有维系与重建组织的能力。",
        "缺陷与复杂处": "对王俊杰的维护曾与自我保护发生冲突；承认这一张力不等于把伤害归咎于受害者。"
      },
      "possessions": [
        "月神与招募资金：高薪招管理、接纳旧部与人数迁移体现她实际经营，不是只有情感付出。",
        "冰霜龙蛋与坐骑：保住蛋、等待成长到后来实战骑乘有先后，不能在取得蛋时就写成成熟龙骑。"
      ],
      "psychology": {
        "agenda": "早期更倾向维护王俊杰与共同事业；剧变后要处理自身创痛、旧组织解散及重新立足。",
        "complexity": "受伤之后仍选择经营，不表示已无痛苦；转为盟友也不抹去此前与雪月的冲突。",
        "trauma": "现实暴力与重要关系崩塌是已发生的重创。可写事件及后续行动，不诊断具体精神疾病，也不擅写私人感官回闪。"
      },
      "relationships": [
        {
          "analysis": "投入、维护和后来遭受的伤害必须并存，不把复杂关系简化为始终自愿或早已毫无感情。",
          "person": "王俊杰"
        },
        {
          "analysis": "敌对之后提出友情和有限合作，以后续共同任务改变关系，而非一笔删除旧事。",
          "person": "书生与雪月"
        },
        {
          "analysis": "她以资金、岗位和行动维系他人，体现独立于恋爱线的领袖责任。",
          "person": "管理者、旧部与玄雨盟友"
        }
      ]
    },

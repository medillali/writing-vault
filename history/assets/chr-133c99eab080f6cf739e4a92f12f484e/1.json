{
  "asset_id": "chr-133c99eab080f6cf739e4a92f12f484e",
  "asset_type": "character",
  "content": {
    "summary": "凌雪不是只负责赠物和陪伴的恋爱奖励。她先为故事提供入口，再成为有独立判断的战斗搭档；关系中的接纳、拒绝与命名也由她亲自参与。她和书生之间值得研究的是互相改变行动条件，而非援助金额越来越大。",
    "上游人物审计": "character-arc-02",
    "人物": "凌雪",
    "代价与限制": "两次旧战死亡、父亡、职业与游戏时间取舍",
    "关系怎样变化": "与书生是援助和回报不断换向的伙伴关系；与凌月有姐妹支持，也存在不同场景中的知情差；家庭要求和公司责任不能被恋爱线吞没。",
    "塑造方法": "写亲密关系时，可让同一资源先解决生存，再改变战斗分工，最后重新触发双方对关系的理解。角色有权收礼、拒礼、改口，也有权不立即解释；这些行动比直接贴上活泼或深情的标签更有辨识度。",
    "方法的失效条件": "若只保留她美丽、赠物和牺牲的一面，自主性会被抹掉；若把第一次拒戒写成已知创伤的必然表现，就替原文补造了没有明确揭晓的心理答案。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "从开篇行为看，她愿意帮助眼前困窘的人；合作后既要保护伙伴，也要保留自己对关系的解释权。后期战斗、家庭责任与现实工作继续占用她的时间，不能把所有生活目标归结为等待主角。",
    "相关剧情事件": [
      "v1-gift",
      "v1-v1c35",
      "v2-refuse",
      "v2-accept",
      "v2-return",
      "v3-v03-promise",
      "v4-v04-campus",
      "v7-v07-xun",
      "v8-v08-father",
      "v8-v08-after"
    ],
    "结局与最后可靠状态": "主明确恋人；冰雪天域285/神舞；现实工作与再聚，主雪婚未实写",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "当前全书研究仍未给早醉因、拒戒哭因的完整单一解释，不用末温暖反填",
    "起点与处境": "被救后回赠头盔/逐步为搭档，卷三仍拒女友名分",
    "选择与变化": [
      "头盔已绑定后，她决定赠出，并留下钱和求职去处；帮助同时解决工具、生活和社会入口。",
      "流光剑到手后，她从高防低攻转成实际输出主力；礼物产生了可验证的作战变化，随后又把两人带进共同冒险。",
      "送暗金戒时哭拒，后来又收下存库；她拒绝的具体原因不能凭读者想象填满，更不能写成永久拒绝这个物件。",
      "书生归零后，她买回已售的黄金王者旧弓，并按经验归属规则带练；还礼没有终结关系，主动投入时间再次定义了关系。",
      "曾拒女友名分，后来校园公开称男友；亲近、承诺和公开身份分时发生，后期拒荀也由她自己作出。"
    ]
  },

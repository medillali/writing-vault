{
  "asset_id": "chr-dca5296e89eedc5f2b643baaf72d5005",
  "asset_type": "character",
  "content": {
    "summary": "书生的全书变化，是行动余地的扩大与关系债务的增加同时发生：最初需要一份工作和进入游戏的条件，后来能决定战利品、领地与他人的去留，最后接下龙域的持续责任。应同时看见他的照料、护短和权力带来的强制与报复。",
    "上游人物审计": "character-arc-01",
    "人物": "丁舒升／轻狂书生",
    "代价与限制": "两次归零、活祭损级/装备、同伴损失、北冥碎、冰兰封冻；也以组织/资本权力伤敌",
    "关系怎样变化": "凌雪既提供起点也在归零时托底；凌月把个人战力连接组织经营；秦韵让亲密关系中的含混与离开成为后果；冰兰使师生的救援方向反转。这些关系都应保留对方的行动，不能写成书生单向成全众人。",
    "塑造方法": "可研究同一优点如何在权力变大后显出阴影：护同伴能发展成补偿责任，也可能变成过度报复。让受影响者的损失和异议留在故事里，人物复杂性才不会被战绩抹平。",
    "方法的失效条件": "如果每次失去都靠更强装备立即补平，归零就只是换一套升级数字；如果旁人的评价永远证明他正确，权力矛盾也会失效。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "早期先求谋生与回报援助；组织形成后，要守住共同生活并战胜对手；后期则不断在继续变强和不愿失去具体的人之间选择。财富已不再能单独回答他为何行动。",
    "相关剧情事件": [
      "v2-zero",
      "v2-return",
      "v4-v04-firstcity",
      "v4-v04-hushou",
      "v7-v07-split",
      "v8-v08-sacrifice",
      "v8-v08-after"
    ],
    "结局与最后可靠状态": "285/永恒太古/月哀天脉绑定；工作室已解、间歇上线、每月探冰接龙域账",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "原名丁舒升：0004本人纠称、0966 CGL字幕再证；丁书生是误称/招呼名，不另建人。圣域归零非线性增；接账不等付款已展示",
    "起点与处境": "生计窘迫、以游戏收入求行动余地；龙语转职归零",
    "选择与变化": [
      "在有利的剑火邀约面前，因欠凌雪之情暂不加盟；他早期的组织选择已受私人关系约束。",
      "龙语者任务成功却因红名死亡归零，隐藏职业没有替他保存已积累的一切；重练必须接受别人帮助。",
      "建会和领地把个人收益变为维护与补偿责任；失误会落在普通成员身上，领袖的情义需要用资源和时间兑现。",
      "圣域再归零、组织分离和城毁说明胜利不能永久固定共同体；最后活祭救冰兰、接龙域职责，把强者的位置改成承担持续成本的人。"
    ]
  },

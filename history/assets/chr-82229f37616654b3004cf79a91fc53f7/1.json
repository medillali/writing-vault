{
  "asset_id": "chr-82229f37616654b3004cf79a91fc53f7",
  "asset_type": "character",
  "content": {
    "summary": "稻花香先作为能封住主角一方的危险对手出现，同时又做出暗助。现实救援使读者重新理解她的受控处境，但人物弧更关键的后续，是她逐渐能自己拒绝和选择，而不止被移到主角阵营。",
    "上游人物审计": "character-arc-06",
    "人物": "林香／稻花香",
    "代价与限制": "旧伤、家族欺凌、强控制被克制的限制",
    "关系怎样变化": "与林傲的控制关系、与书生的受助和协战、与共同体的生活联系分别建档；不能用加入雪月一笔清除既往伤害。",
    "塑造方法": "先让角色具有超出阵营标签的行动，再揭示处境，随后安排一次不由救援者代答的选择。自主性要在获救之后继续增长。",
    "方法的失效条件": "不要把强控制技能等同完整人格，也不把被救后的感激写成对所有未来安排的同意。",
    "档案定位": "全书人物主档；原阶段卡为依据，身份不按相近姓名自动合并。",
    "目标怎样变化": "从受控制的处境中取得安全与行动空间；战斗贡献、共同生活和现实实习分别提供她能够参与而非只被照护的位置。",
    "相关剧情事件": [
      "v2-seal",
      "v2-zero",
      "v3-v03-token",
      "v4-v04-rescuexiang",
      "v7-v07-canglong",
      "v8-v08-family"
    ],
    "结局与最后可靠状态": "仍圣域275无末飞升证；留蓝星/现实聚会，有自己的拒绝",
    "编辑深度": "人物选择与创作研究",
    "证据与未知边界": "完整身世与控制缘由按前卷，不由主猜填",
    "起点与处境": "受林傲控制又暗援书的巫师、现实受伤",
    "选择与变化": [
      "同处敌方并不抹去暗助建帮的行动，早期阵营标签开始不足以说明她。",
      "现实获救后仍有伤和噩梦；新住所不是即时痊愈。",
      "高血与封印控制多次成为队伍窗口，受保护者也能反过来支撑别人。",
      "面对祭祖要求，由她本人作出拒绝；这比由主角替她宣布断绝关系更能落实自主性。"
    ]
  },
